{
  "name": "@tactia/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "lint": "eslint src --ignore-pattern generated",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@tactia/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^6.19.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "eslint": "^9.34.0"
  }
}
