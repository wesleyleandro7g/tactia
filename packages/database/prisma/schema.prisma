// ---------------------------------------------------------------------------
// Better Auth tables (provider-owned). Domain User maps via externalAuthId.
// ---------------------------------------------------------------------------

model AuthUser {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      AuthSession[]
  accounts      AuthAccount[]
  domainUser    User?
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]

  @@unique([email])
  @@map("auth_users")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id
  issuer                String    @default("credential")
  accountId             String
  providerId            String
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

model Jwks {
  id         String    @id
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  createdAt  DateTime  @map("created_at")
  expiresAt  DateTime? @map("expires_at")
  alg        String?
  crv        String?

  @@map("auth_jwks")
}

model OauthClient {
  id                               String                @id
  clientId                         String                @unique @map("client_id")
  clientSecret                     String?               @map("client_secret")
  clientDiscoveryId                String?               @map("client_discovery_id")
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?              @map("skip_consent")
  enableEndSession                 Boolean?              @map("enable_end_session")
  subjectType                      String?               @map("subject_type")
  scopes                           String[]
  clientCredentialsScopes         String[]              @default([]) @map("client_credentials_scopes")
  userId                           String?               @map("user_id")
  user                             AuthUser?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?              @map("created_at")
  updatedAt                        DateTime?              @map("updated_at")
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]              @default([])
  tos                              String?
  policy                           String?
  softwareId                       String?               @map("software_id")
  softwareVersion                  String?               @map("software_version")
  softwareStatement                String?               @map("software_statement")
  redirectUris                     String[]              @map("redirect_uris")
  postLogoutRedirectUris           String[]              @default([]) @map("post_logout_redirect_uris")
  backchannelLogoutUri             String?               @map("backchannel_logout_uri")
  backchannelLogoutSessionRequired Boolean?              @map("backchannel_logout_session_required")
  tokenEndpointAuthMethod          String?               @map("token_endpoint_auth_method")
  applicationType                  String?               @map("application_type")
  jwks                             String?
  jwksUri                          String?               @map("jwks_uri")
  grantTypes                       String[]              @map("grant_types")
  responseTypes                    String[]              @map("response_types")
  requirePKCE                      Boolean?              @map("require_pkce")
  dpopBoundAccessTokens            Boolean?              @default(false) @map("dpop_bound_access_tokens")
  referenceId                      String?               @map("reference_id")
  metadata                         Json?
  resources                        OauthClientResource[]
  refreshTokens                    OauthRefreshToken[]
  accessTokens                     OauthAccessToken[]
  consents                         OauthConsent[]

  @@index([userId])
  @@map("oauth_clients")
}

model OauthResource {
  id                            String                @id
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?                  @map("access_token_ttl")
  refreshTokenTtl               Int?                  @map("refresh_token_ttl")
  signingAlgorithm              String?               @map("signing_algorithm")
  signingKeyId                  String?               @map("signing_key_id")
  allowedScopes                 String[]              @map("allowed_scopes")
  customClaims                  Json?                 @map("custom_claims")
  dpopBoundAccessTokensRequired Boolean?              @default(false) @map("dpop_bound_access_tokens_required")
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?             @map("created_at")
  updatedAt                     DateTime?             @map("updated_at")
  policyVersion                 Int?                  @default(1) @map("policy_version")
  metadata                      Json?
  clients                       OauthClientResource[]

  @@map("oauth_resources")
}

model OauthClientResource {
  id         String        @id
  clientId   String        @map("client_id")
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String        @map("resource_id")
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?     @map("created_at")

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resources")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String             @unique
  clientId                String             @map("client_id")
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?            @map("session_id")
  session                 AuthSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String             @map("user_id")
  user                    AuthUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?            @map("reference_id")
  authorizationCodeId     String?            @map("authorization_code_id")
  resources               String[]
  requestedUserInfoClaims String[]           @default([]) @map("requested_user_info_claims")
  expiresAt               DateTime?          @map("expires_at")
  createdAt               DateTime?          @map("created_at")
  revoked                 DateTime?
  rotatedAt               DateTime?          @map("rotated_at")
  rotationReplayResponse  String?            @map("rotation_replay_response")
  rotationReplayExpiresAt DateTime?          @map("rotation_replay_expires_at")
  authTime                DateTime?          @map("auth_time")
  confirmation            Json?
  scopes                  String[]
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_tokens")
}

model OauthAccessToken {
  id                      String             @id
  token                   String?            @unique
  clientId                String             @map("client_id")
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?            @map("session_id")
  session                 AuthSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?            @map("user_id")
  user                    AuthUser?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?            @map("reference_id")
  authorizationCodeId     String?            @map("authorization_code_id")
  resources               String[]
  requestedUserInfoClaims String[]           @default([]) @map("requested_user_info_claims")
  refreshId               String?            @map("refresh_id")
  refreshToken            OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime?          @map("expires_at")
  createdAt               DateTime?          @map("created_at")
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_tokens")
}

model OauthConsent {
  id                      String      @id
  clientId                String      @map("client_id")
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?     @map("user_id")
  user                    AuthUser?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?     @map("reference_id")
  resources               String[]
  requestedUserInfoClaims String[]    @default([]) @map("requested_user_info_claims")
  scopes                  String[]
  createdAt               DateTime?   @map("created_at")
  updatedAt               DateTime?   @map("updated_at")

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consents")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime @map("expires_at")

  @@map("oauth_client_assertions")
}

model McpRateLimitBucket {
  key             String   @id
  windowStartedAt DateTime @map("window_started_at")
  count           Int
  expiresAt       DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("mcp_rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// Operator identity (backoffice). Separate Better Auth tables so a client
// credential can never become an operator session and vice versa.
// ---------------------------------------------------------------------------

model OperatorAuthUser {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      OperatorAuthSession[]
  accounts      OperatorAuthAccount[]
  domainOperator Operator?

  @@unique([email])
  @@map("operator_auth_users")
}

model OperatorAuthSession {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      OperatorAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("operator_auth_sessions")
}

model OperatorAuthAccount {
  id                    String    @id
  issuer                String    @default("credential")
  accountId             String
  providerId            String
  userId                String
  user                  OperatorAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("operator_auth_accounts")
}

model OperatorAuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("operator_auth_verifications")
}

model Operator {
  id             String         @id @db.Uuid
  externalAuthId String         @unique @map("external_auth_id")
  name           String
  email          String
  status         OperatorStatus @default(active)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  authUser       OperatorAuthUser @relation(fields: [externalAuthId], references: [id], onDelete: Restrict)
  auditLogs      AuditLog[]

  @@unique([email])
  @@index([status])
  @@index([createdAt])
  @@map("operators")
}

// ---------------------------------------------------------------------------
// Domain identity
// ---------------------------------------------------------------------------

model Tenant {
  acquisitionLead AcquisitionLead?
  id           String       @id @db.Uuid
  name         String
  slug         String
  status       TenantStatus @default(active)
  timezone     String       @default("America/Sao_Paulo")
  currency     String       @default("BRL")
  browserAgentSkillMarkdown String @default("") @map("browser_agent_skills") @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  memberships  Membership[]
  auditLogs    AuditLog[]
  customers    Customer[]
  leads        Lead[]
  products     Product[]
  sellers      Seller[]
  sales        Sale[]
  saleItems    SaleItem[]
  activities   Activity[]
  interactions Interaction[]
  credentials  Credential[]
  dataSources  DataSource[]
  syncJobs     SyncJob[]
  rawRecords   RawRecord[]
  mappings     Mapping[]
  imports      Import[]
  qualityReports DataQualityReport[]
  metrics        Metric[]
  metricSnapshots MetricSnapshot[]
  insights       Insight[]
  recommendations Recommendation[]
  briefings      Briefing[]
  goals          Goal[]
  businessFacts  BusinessFact[]
  tenantSettings TenantSettings?
  expenses       Expense[]
  payments       Payment[]
  inventoryLevels InventoryLevel[]
  campaigns      Campaign[]
  leadStageTransitions LeadStageTransition[]
  conversations  Conversation[]
  actions          Action[]
  actionExecutions ActionExecution[]
  approvals        Approval[]
  episodes         Episode[]
  playbooks        Playbook[]
  knowledgeDocuments KnowledgeDocument[]
  documentChunks     DocumentChunk[]
  mediaAssets        MediaAsset[]
  infographicAssets  InfographicAsset[]
  apiKeys            TenantApiKey[]
  whatsappNumbers    WhatsappAuthorizedNumber[]
  customFieldDefinitions CustomFieldDefinition[]
  integrationModuleRuns IntegrationModuleRun[]
  integrationArtifacts IntegrationArtifact[]
  browserExecutorInstances BrowserExecutorInstance[]
  browserWorkflows      BrowserWorkflow[]
  browserWorkflowBindings BrowserWorkflowBinding[]
  browserAutomationProfiles BrowserAutomationProfile[]
  browserAutomationTasks BrowserAutomationTask[]
  browserAutomationSessions BrowserAutomationSession[]
  browserAutomationArtifacts BrowserAutomationArtifact[]
  browserAutomationActionLogs BrowserAutomationActionLog[]
  agentSkills AgentSkill[]
  schedules            Schedule[]
  scheduleOccurrences  ScheduleOccurrence[]

  @@unique([slug])
  @@index([status])
  @@index([createdAt])
  @@map("tenants")
}

enum AcquisitionLeadStatus {
  new
  contacted
  scheduled
  qualified
  converted
  closed
}

// Tactia's own prospects, deliberately independent from tenant CRM leads.
model AcquisitionLead {
  id             String @id @db.Uuid
  submissionId   String @unique @map("submission_id") @db.Uuid
  name           String
  email          String
  whatsapp       String
  phone          String?
  company        String
  segment        String?
  segmentOther   String? @map("segment_other")
  employeeRange  String? @map("employee_range")
  revenueRange   String? @map("revenue_range")
  systems        String[]
  systemDetails  String? @map("system_details")
  context        String?
  source         String @default("web")
  attribution    Json?
  status         AcquisitionLeadStatus @default(new)
  tenantId       String? @unique @map("tenant_id") @db.Uuid
  tenant         Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("acquisition_leads")
}

model User {
  id             String       @id @db.Uuid
  externalAuthId String       @unique @map("external_auth_id")
  name           String
  email          String
  avatarUrl      String?      @map("avatar_url")
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  authUser       AuthUser     @relation(fields: [externalAuthId], references: [id], onDelete: Restrict)
  memberships    Membership[]
  auditLogs      AuditLog[]
  sellers        Seller[]
  conversations  Conversation[]
  insightFeedbacks InsightFeedback[]
  businessFacts  BusinessFact[]
  createdApiKeys TenantApiKey[]
  whatsappNumbers WhatsappAuthorizedNumber[]

  @@index([email])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

model Membership {
  id        String           @id @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      MembershipRole
  status    MembershipStatus @default(active)
  deletedAt DateTime?        @map("deleted_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId])
  @@index([tenantId, createdAt])
  @@index([deletedAt])
  @@map("memberships")
}

model TenantApiKey {
  id         String          @id @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  name       String
  prefix     String
  hash       String
  scopes     String[]        @default(["tools:read"])
  role       MembershipRole
  createdBy  String          @map("created_by") @db.Uuid
  lastUsedAt DateTime?       @map("last_used_at")
  revokedAt  DateTime?       @map("revoked_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator    User            @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([prefix])
  @@index([tenantId, revokedAt])
  @@map("tenant_api_keys")
}

model WhatsappAuthorizedNumber {
  id                   String    @id @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  phone                String
  label                String?
  conversationId       String?   @map("conversation_id") @db.Uuid
  lastInboundMessageId String?   @map("last_inbound_message_id")
  disabledAt           DateTime? @map("disabled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation         Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([phone])
  @@index([tenantId, disabledAt])
  @@index([userId])
  @@map("whatsapp_authorized_numbers")
}

model AuditLog {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  operatorId String?  @map("operator_id") @db.Uuid
  actorType  String   @map("actor_type")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, entityType, entityId])
  @@index([userId])
  @@index([operatorId])
  @@map("audit_logs")
}

model CustomFieldDefinition {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  entityType  String   @map("entity_type")
  fieldKey    String   @map("field_key")
  label       String
  fieldType   String   @map("field_type")
  description String?
  required    Boolean  @default(false)
  config      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, fieldKey])
  @@index([tenantId, entityType])
  @@map("custom_field_definitions")
}

// ---------------------------------------------------------------------------
// Canonical business data (Etapa 2)
// data_source_id is nullable until DataSource lands in Etapa 3.
// ---------------------------------------------------------------------------

model Customer {
  id           String         @id @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  dataSourceId String?        @map("data_source_id") @db.Uuid
  externalId   String?        @map("external_id")
  name         String
  email        String?
  phone        String?
  document     String?
  segment      String?
  city         String?
  state        String?
  acquisitionSource String? @map("acquisition_source")
  status       CustomerStatus @default(active)
  metadata     Json?
  customData   Json           @default("{}") @map("custom_data")
  /// Written via raw SQL (pgvector). Never selected through Prisma.
  embedding    Unsupported("vector")?
  embeddedAt   DateTime?      @map("embedded_at")
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
