# =============================================================================
# Tactia — Landing de consultoria (apps/landing, Astro em :4321)
# Copie para .env e preencha os valores. Agrupadas por utilização.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Build / runtime (dev)
# -----------------------------------------------------------------------------
# URL absoluta HTTP(S) do site. Obrigatória: o build do Astro falha sem ela.
PUBLIC_SITE_URL=https://consultoria.example.com
# Origem do Tactia (apps/web) para onde o proxy encaminha /api. Default no dev.
LANDING_API_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. Deploy de produção (docker/docker-compose.prod.yml + nginx)
# Use .env.production e NÃO o commite. Defaults entre parênteses.
# -----------------------------------------------------------------------------
# URL pública passada como PUBLIC_SITE_URL no build da imagem da landing.
# LANDING_SITE_URL=https://consultoria.example.com
# Interface/porta publicadas pelo container nginx (default 127.0.0.1:3002 -> 80).
# LANDING_BIND=127.0.0.1
# LANDING_PORT=3002
# Proxy confiável para set_real_ip_from no nginx (default 127.0.0.1).
# LANDING_TRUSTED_PROXY=127.0.0.1
