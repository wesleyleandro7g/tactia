---
import LeadForm from '../components/LeadForm.astro';
import SiteLayout from '../components/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import '../styles/home.css';

const paths = [
  { verb: 'Aprenda.', brand: 'Academy', question: 'Quero aprender a aplicar IA e tecnologia.', context: 'Desenvolva habilidades para criar soluções na sua empresa ou na carreira.', href: '/academy', cta: 'Explorar a Academy', key: 'academy' },
  { verb: 'Construa.', brand: 'Build', question: 'Preciso de sistemas ou integrações melhores.', context: 'Organize processos e conecte ferramentas de acordo com a sua operação.', href: '/build', cta: 'Conhecer a Build', key: 'build' },
  { verb: 'Delegue.', brand: 'Workforce', question: 'Quero parar de executar tarefas repetitivas.', context: 'Avalie a delegação de rotinas definidas com acompanhamento e limites.', href: '/workforce', cta: 'Conhecer a Workforce', key: 'workforce' },
  { verb: 'Decida.', brand: 'Intelligence', question: 'Quero entender melhor os dados da empresa.', context: 'Explore uma visão mais conectada de indicadores e decisões.', href: '/intelligence', cta: 'Conhecer a Intelligence', key: 'intelligence' },
];

const offers = [
  { number: '01', verb: 'APRENDA', brand: 'Academy', headline: 'Da curiosidade à capacidade de construir.', text: 'Formações práticas de IA e automação para desenvolver repertório e criar soluções.', tags: ['Formações', 'Projetos'], href: '/academy', cta: 'Ver formações', tone: 'academy', status: 'Em preparação' },
  { number: '02', verb: 'CONSTRUA', brand: 'Build', headline: 'Software feito para o jeito como sua empresa trabalha.', text: 'Criamos, integramos e modernizamos sistemas. Construir do zero é uma opção, não uma obrigação.', tags: ['Sistemas', 'Integrações'], href: '/build', cta: 'Explorar a Build', tone: 'build', status: '' },
  { number: '03', verb: 'DELEGUE', brand: 'Workforce', headline: 'Delegue rotinas. Receba trabalho executado.', text: 'Funcionários digitais e automações para atividades definidas, com regras e acompanhamento.', tags: ['Rotinas', 'Execução'], href: '/workforce', cta: 'Conhecer funcionários digitais', tone: 'workforce', status: '' },
  { number: '04', verb: 'DECIDA', brand: 'Intelligence', headline: 'Seus dados já sabem a resposta.', text: 'Uma proposta para conectar informações e investigar o negócio com mais contexto.', tags: ['Dados', 'Análises'], href: '/intelligence', cta: 'Explorar a Intelligence', tone: 'intelligence', status: 'Em avaliação' },
];

const spotlights = [
  ['Academy', 'APRENDA', 'De usar ferramentas de IA a criar soluções com elas.', 'Explore um caminho de aprendizado aplicado a problemas reais. As primeiras formações estão em preparação.', 'Formações · projetos · prática', '/academy', 'Conhecer a Academy'],
  ['Build', 'CONSTRUA', 'Quando a operação é única, a tecnologia precisa acompanhar.', 'Sistemas internos, integrações e modernização: avaliamos o que vale adaptar, conectar ou construir.', 'Sistemas · integrações · modernização', '/build', 'Conversar sobre um projeto'],
  ['Workforce', 'DELEGUE', 'Trabalho repetitivo não precisa depender de execução manual.', 'Defina uma tarefa e o resultado esperado. Avaliamos se há um caminho viável para uma operação recorrente.', 'Tarefas · entregas · supervisão', '/workforce', 'Descobrir o que posso delegar'],
  ['Intelligence', 'DECIDA', 'A resposta pode estar nos dados que sua empresa já tem.', 'Uma proposta para relacionar fontes e indicadores e apoiar perguntas melhores sobre o negócio.', 'Dados · indicadores · contexto', '/intelligence', 'Conhecer a Intelligence'],
];

const method = [
  ['01', 'Entender', 'Começamos pelo problema, pelos processos e pelo resultado que você espera.'],
  ['02', 'Recomendar', 'Avaliamos educação, software, execução, inteligência ou uma combinação que faça sentido.'],
  ['03', 'Colocar em prática', 'Escopo, entregas, responsabilidades e condições são definidos na oferta correspondente.'],
  ['04', 'Evoluir', 'Quando aplicável, observamos o que funciona e identificamos próximos passos dentro do escopo.'],
];

const faq = [
  ['A Tactia é uma empresa de software ou de IA?', 'A Tactia reúne educação, desenvolvimento de software, execução de processos com IA e inteligência de dados. O ponto de partida é o problema do negócio.'],
  ['Preciso contratar todos os produtos?', 'Não. Você pode começar pela frente adequada à sua necessidade. As soluções se complementam quando há motivo para isso, mas não exigem contratação conjunta.'],
  ['Meus sistemas precisam ser substituídos?', 'Não necessariamente. Integrar, adaptar ou aproveitar o que existe pode ser mais adequado do que reconstruir. A decisão depende da viabilidade e do escopo.'],
  ['Funcionários digitais substituem pessoas?', 'A Workforce avalia tarefas delegáveis com limites, aprovações e supervisão apropriados. Não há promessa de substituição integral de profissionais.'],
  ['Preciso saber programar para começar pela Academy?', 'Depende da formação. Nível e pré-requisitos serão informados em cada oferta quando estiver disponível.'],
  ['A Intelligence acessa automaticamente qualquer sistema?', 'Não. A conexão depende das fontes, permissões e integrações viáveis. A qualidade das análises depende dos dados disponíveis.'],
  ['Quanto custa?', 'As condições variam: formações têm ofertas próprias; Build, Workforce e Intelligence dependem de escopo, viabilidade e modalidade contratada.'],
  ['Não sei qual caminho escolher. Como começo?', 'Use o seletor para conhecer as opções ou conte seu desafio no formulário. A equipe avaliará as informações antes de indicar o próximo passo.'],
];

const needs = [
  { value: 'academy', label: 'Aprender ou capacitar minha equipe' },
  { value: 'build', label: 'Criar um sistema ou integrar ferramentas' },
  { value: 'workforce', label: 'Delegar tarefas ou processos recorrentes' },
  { value: 'intelligence', label: 'Conectar dados e melhorar decisões' },
  { value: 'discovery', label: 'Ainda não sei por onde começar' },
];
---

<SiteLayout title="Tactia | Tecnologia e IA para transformar seu negócio" description="Aprenda a aplicar IA, desenvolva sistemas sob medida, delegue processos a funcionários digitais e conecte seus dados com a Tactia." canonicalPath="/" theme="dark" home>
  <section class="home-hero home-shell" aria-labelledby="home-title"><div class="home-hero__copy"><p class="home-label"><span aria-hidden="true"><Icon name="sparkle" /></span> TECNOLOGIA E IA APLICADAS A NEGÓCIOS</p><h1 id="home-title">Tecnologia que trabalha <em>pelo seu negócio.</em></h1><p class="home-hero__intro">Aprenda a aplicar IA, construa sistemas sob medida, delegue tarefas e conecte os dados da sua empresa. Quatro caminhos para melhorar a maneira como sua operação funciona.</p><div class="home-actions"><a class="home-button" href="#encontre-sua-solucao" data-home-hero="primary">Encontrar minha solução <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a><a class="home-link" href="#solucoes" data-home-hero="secondary">Explorar o ecossistema <span aria-hidden="true"><Icon name="arrow-down-right" /></span></a></div><p class="home-hero__note">Quatro caminhos. Um objetivo: fazer sua empresa operar melhor.</p></div><div class="home-map" aria-label="Diagrama ilustrativo dos quatro caminhos da Tactia"><div class="home-map__top"><span>TACTIA / UM ECOSSISTEMA</span><span>04 CAMINHOS</span></div><div class="home-map__grid"><div class="home-map__tile"><span>01 / ACADEMY</span><strong>Aprenda<span>.</span></strong><small>Conhecimento em prática</small><i aria-hidden="true"><Icon name="arrow-up-right" /></i></div><div class="home-map__tile"><span>02 / BUILD</span><strong>Construa<span>.</span></strong><small>Sistemas para a operação</small><i aria-hidden="true"><Icon name="arrow-up-right" /></i></div><div class="home-map__tile"><span>03 / WORKFORCE</span><strong>Delegue<span>.</span></strong><small>Rotinas com entregas</small><i aria-hidden="true"><Icon name="arrow-up-right" /></i></div><div class="home-map__tile"><span>04 / INTELLIGENCE</span><strong>Decida<span>.</span></strong><small>Dados com contexto</small><i aria-hidden="true"><Icon name="arrow-up-right" /></i></div></div><div class="home-map__bottom"><span>UM PONTO DE PARTIDA</span><i aria-hidden="true"></i><span>A SUA OPERAÇÃO</span></div></div></section>

  <div class="home-signature"><div class="home-shell">{paths.map((path) => <a href="#encontre-sua-solucao"><strong>{path.verb}</strong><span>{path.brand}</span></a>)}</div></div>

  <section id="encontre-sua-solucao" class="home-section home-finder" aria-labelledby="finder-title"><div class="home-shell"><div class="home-heading home-heading--split"><div><p class="home-label">01 / POR ONDE COMEÇAR?</p><h2 id="finder-title">Qual é o próximo desafio <em>da sua empresa?</em></h2></div><p>Não precisa escolher uma tecnologia antes de entender a necessidade. Encontre um caminho pelo problema que quer resolver.</p></div><div class="home-finder__grid">{paths.map((path, index) => <article><span class="home-finder__number">0{index + 1} / {path.verb.toUpperCase()}</span><h3>{path.question}</h3><p>{path.context}</p><div class="home-finder__route"><span>CAMINHO SUGERIDO / TACTIA {path.brand.toUpperCase()}</span><a href={path.href} data-home-selector={path.key}>{path.cta} <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></article>)}</div><div class="home-finder__unsure"><div><strong>Não sei por onde começar.</strong><p>Compartilhe seu desafio para avaliarmos qual caminho vale considerar.</p></div><a class="home-link home-link--dark" href="#diagnostico">Pedir orientação <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></div></section>

  <section class="home-section home-friction"><div class="home-shell"><div class="home-heading home-heading--split"><div><p class="home-label">02 / TECNOLOGIA DEVERIA SIMPLIFICAR</p><h2>Sua empresa cresce. A complexidade <em>não deveria crescer junto.</em></h2></div><p>Sistemas que não conversam, planilhas manuais, informações espalhadas e equipes ocupadas com rotinas que poderiam funcionar de outra forma.</p></div><div class="home-friction__grid"><article><span>01</span><h3>Tempo perdido</h3><p>Tarefas repetidas roubam atenção do cliente e do negócio.</p></article><article><span>02</span><h3>Sistemas fragmentados</h3><p>Informações ficam separadas em ferramentas e departamentos.</p></article><article><span>03</span><h3>Pouca visibilidade</h3><p>Os dados existem, mas transformá-los em respostas exige esforço.</p></article><article><span>04</span><h3>Capacidade limitada</h3><p>Crescer sem organizar processos pode aumentar o atrito.</p></article></div><p class="home-friction__statement">O ponto não é adicionar mais uma ferramenta. É conectar a tecnologia certa ao trabalho certo.</p></div></section>

  <section id="solucoes" class="home-section home-offers" aria-labelledby="offers-title"><div class="home-shell"><div class="home-heading home-heading--split"><div><p class="home-label">03 / O ECOSSISTEMA TACTIA</p><h2 id="offers-title">A solução certa depende do que você precisa <em>fazer agora.</em></h2></div><p>Comece por um desafio e evolua conforme a empresa precisar. Cada frente tem um papel e uma próxima ação próprios.</p></div><div class="home-offers__grid">{offers.map((offer) => <article class:list={['home-offer', `home-offer--${offer.tone}`]}><div class="home-offer__top"><span>{offer.number} / {offer.verb}</span><span>{offer.status}</span></div><h3>Tactia <strong>{offer.brand}</strong></h3><p class="home-offer__headline">{offer.headline}</p><p class="home-offer__text">{offer.text}</p><div class="home-offer__bottom"><div>{offer.tags.map((tag) => <span>{tag}</span>)}</div><a href={offer.href} data-home-product={offer.brand}>{offer.cta} <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></article>)}</div></div></section>

  <section class="home-section home-spotlights" aria-labelledby="spotlights-title"><div class="home-shell"><div class="home-heading"><p class="home-label">04 / UM OLHAR MAIS DE PERTO</p><h2 id="spotlights-title">Quatro jeitos de transformar <em>o trabalho.</em></h2></div><div class="home-spotlights__list">{spotlights.map(([brand, verb, title, text, topics, href, cta], index) => <article><div class="home-spotlight__identity"><span>0{index + 1} / {verb}</span><strong>{brand}</strong></div><div><h3>{title}</h3><p>{text}</p><small>{topics}</small></div><a href={href} data-home-spotlight={brand}>{cta} <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></article>)}</div></div></section>

  <section class="home-section home-journey"><div class="home-shell home-journey__grid"><div><p class="home-label">05 / UM ECOSSISTEMA. DIFERENTES CAMINHOS.</p><h2>Um desafio pode revelar <em>mais de um caminho.</em></h2><p>Imagine uma distribuidora com vendas, estoque e financeiro em sistemas distintos. É possível começar por uma necessidade e avaliar as demais apenas quando fizer sentido.</p><p class="home-journey__note">Exemplo hipotético. Não representa cliente, projeto entregue ou contratação conjunta obrigatória.</p><a class="home-link" href="#diagnostico">Quero avaliar meu cenário <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div><ol><li><span>BUILD</span><p>Avaliar a conexão entre sistemas.</p></li><li><span>WORKFORCE</span><p>Estruturar uma rotina recorrente de acompanhamento.</p></li><li><span>INTELLIGENCE</span><p>Organizar indicadores para investigar resultados.</p></li><li><span>ACADEMY</span><p>Preparar pessoas para os novos processos.</p></li></ol></div></section>

  <section id="como-funciona" class="home-section home-method" aria-labelledby="method-title"><div class="home-shell"><div class="home-heading home-heading--split"><div><p class="home-label">06 / DA NECESSIDADE À SOLUÇÃO</p><h2 id="method-title">Começamos pelo problema. <em>Depois escolhemos a tecnologia.</em></h2></div><p>Para aprender pela Academy, você pode começar diretamente pelas formações disponíveis. Para desafios empresariais, o escopo começa por uma conversa sobre a operação.</p></div><ol class="home-method__steps">{method.map(([number, title, text]) => <li><span>{number}</span><h3>{title}</h3><p>{text}</p></li>)}</ol><a class="home-link home-link--dark" href="#diagnostico">Conversar sobre meu desafio <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></section>

  <section id="por-que-tactia" class="home-section home-why"><div class="home-shell home-why__grid"><div><p class="home-label">07 / TECNOLOGIA COM PROPÓSITO</p><h2>Não começamos pela ferramenta. <em>Começamos pelo trabalho que precisa melhorar.</em></h2><p>Conhecimento, engenharia, execução e inteligência se conectam à realidade de cada empresa. A solução mais elaborada nem sempre é o próximo passo certo.</p></div><div class="home-why__list"><p><span>01</span> Entendemos a prioridade do negócio.</p><p><span>02</span> Avaliamos integrar, adaptar ou construir.</p><p><span>03</span> Definimos limites e responsabilidades.</p><p><span>04</span> Tratamos dados e decisões com critério.</p><p><span>05</span> Preparamos pessoas para evoluir.</p></div></div></section>

  <section id="diagnostico" class="home-section home-contact" aria-labelledby="contact-title"><div class="home-shell home-contact__grid"><div><p class="home-label">08 / VAMOS FALAR DO SEU NEGÓCIO</p><h2 id="contact-title">Seu desafio é o ponto de partida.</h2><p>Conte o que limita sua operação. Vamos considerar se faz sentido aprender, construir, delegar ou decidir com informações melhores.</p><p class="home-contact__note">Sem compromisso de contratação. O envio não confirma reunião nem garante uma recomendação automática. Para responder à solicitação, a API atual exige empresa, e-mail e WhatsApp.</p></div><LeadForm id="home-form" offer="Tactia — orientação de soluções" heading="Conte o que precisa mudar" intro="Escolha a prioridade e compartilhe o contexto, se quiser." submitLabel="Enviar meu desafio" contextLabel="Qual é o principal desafio?" contextPlaceholder="Uma tarefa, sistema ou decisão que merece atenção." needs={needs} successHeading="Recebemos seu contato." successMessage="Obrigado por compartilhar seu desafio. Nossa equipe entrará em contato pelos dados informados para combinar os próximos passos." /></div></section>

  <section class="home-section home-faq" aria-labelledby="faq-title"><div class="home-shell home-faq__grid"><div><p class="home-label">09 / PERGUNTAS FREQUENTES</p><h2 id="faq-title">Antes do próximo passo, <em>algumas respostas.</em></h2></div><div class="home-faq__list">{faq.map(([question, answer], index) => <details><summary><span>{String(index + 1).padStart(2, '0')}</span>{question}<b aria-hidden="true">+</b></summary><p>{answer}</p></details>)}</div></div></section>

  <section class="home-section home-final"><div class="home-shell"><p class="home-label">SEU PRÓXIMO PASSO COMEÇA AQUI</p><h2>O próximo avanço pode começar por <em>um único problema resolvido.</em></h2><p>Aprenda, construa, delegue ou decida. Há um caminho para começar pelo desafio que mais importa agora.</p><div class="home-actions"><a class="home-button" href="#encontre-sua-solucao">Encontrar minha solução <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a><a class="home-link" href="#diagnostico">Conversar com a Tactia <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></div></section>
  <div class="home-closing"><div class="home-shell"><span>TACTIA</span><strong>Aprenda. Construa. Delegue. Decida.</strong></div></div>
</SiteLayout>

<script>
  const emit = (event: string, detail: Record<string, string> = {}) => window.dispatchEvent(new CustomEvent('tactia:funnel', { detail: { event, ...detail } }));
  emit('home_view');
  const header = document.querySelector<HTMLElement>('.workforce-header');
  const updateHeader = () => header?.classList.toggle('home-header--compact', window.scrollY > 40);
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  const menu = document.querySelector<HTMLDetailsElement>('.home-nav-menu');
  document.addEventListener('click', (event) => { if (menu && !menu.contains(event.target as Node)) menu.open = false; });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); } });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));

  document.querySelectorAll<HTMLAnchorElement>('[data-home-hero]').forEach((link) => link.addEventListener('click', () => emit(link.dataset.homeHero === 'primary' ? 'hero_primary_click' : 'hero_secondary_click', { placement: 'hero' })));
  document.querySelectorAll<HTMLAnchorElement>('[data-home-selector]').forEach((link) => link.addEventListener('click', () => emit('solution_selector_click', { need: link.dataset.homeSelector || '', destination: link.getAttribute('href') || '' })));
  document.querySelectorAll<HTMLAnchorElement>('[data-home-product]').forEach((link) => link.addEventListener('click', () => emit('product_card_click', { product: link.dataset.homeProduct || '', placement: 'home' })));
  document.querySelectorAll<HTMLAnchorElement>('[data-home-spotlight]').forEach((link) => link.addEventListener('click', () => emit('product_spotlight_click', { product: link.dataset.homeSpotlight || '' })));
  document.querySelectorAll<HTMLElement>('.home-faq details').forEach((item, index) => item.addEventListener('toggle', () => { if (item instanceof HTMLDetailsElement && item.open) emit('faq_expand', { question_id: String(index + 1) }); }));

  const diagnostic = document.getElementById('diagnostico');
  if (diagnostic && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => { if (entries.some((entry) => entry.isIntersecting)) { emit('diagnostic_view', { placement: 'home' }); observer.disconnect(); } }, { threshold: 0.15 });
    observer.observe(diagnostic);
  }
  document.querySelector('#home-form')?.addEventListener('submit', () => emit('diagnostic_submit', { selected_need: document.querySelector<HTMLSelectElement>('#home-form [name="need"]')?.value || '' }));
  window.addEventListener('tactia:funnel', (event) => {
    if (!(event instanceof CustomEvent) || event.detail?.event !== 'lead_submitted' || event.detail?.offer !== 'Tactia — orientação de soluções') return;
    emit('lead_created', { selected_need: event.detail.need || 'discovery', source: 'home' });
  });
</script>
