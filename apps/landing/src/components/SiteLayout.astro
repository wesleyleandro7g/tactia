---
import bricolageFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '../styles/global.css';
import '../styles/workforce.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  theme?: 'light' | 'dark';
  academy?: boolean;
  build?: boolean;
  workforce?: boolean;
  intelligence?: boolean;
  home?: boolean;
}

const { title, description, canonicalPath = '/', theme = 'light', academy = false, build = false, workforce = false, intelligence = false, home = false } = Astro.props;
const canonical = Astro.site ? new URL(canonicalPath, Astro.site).href : undefined;
const headerLogo = theme === 'dark' ? '/tactia-logo-white.svg' : '/tactia-logo-black.svg';
---

<!doctype html>
<html lang="pt-BR" data-theme={theme} data-brand={academy ? 'academy' : build ? 'build' : workforce ? 'workforce' : intelligence ? 'intelligence' : home ? 'home' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={academy ? '#171a19' : build ? '#edece6' : workforce ? '#191d1b' : intelligence ? '#1c211e' : home ? '#191e1a' : theme === 'dark' ? '#112523' : '#f5f3ed'} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={bricolageFont} as="font" type="font/woff2" crossorigin />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && <meta property="og:image" content={new URL('/social-card.png', Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
  </head>
  <body class="workforce-body">
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="workforce-header">
      <div class="workforce-shell workforce-nav">
        <a class="workforce-brand" href={academy ? '/academy' : build ? '/build' : workforce ? '/workforce' : intelligence ? '/intelligence' : '/'} aria-label={academy ? 'Tactia Academy, início' : build ? 'Tactia Build, início' : workforce ? 'Tactia Workforce, início' : intelligence ? 'Tactia Intelligence, início' : 'Tactia, início'}>
          <img src={headerLogo} alt="Tactia" width="116" height="36" />
          <span>{academy ? 'ACADEMY' : build ? 'BUILD' : workforce ? 'WORKFORCE' : intelligence ? 'INTELLIGENCE' : home ? 'TECNOLOGIA APLICADA' : 'AI WORKFORCE'}</span>
        </a>
        {academy ? (
          <nav aria-label="Navegação da Academy">
            <a href="#como-funciona">Como funciona</a>
            <a href="#formacoes">Trilhas</a>
            <a href="#para-quem">Para quem é</a>
            <a href="#comunidade">Comunidade</a>
            <a href="#perguntas">Perguntas frequentes</a>
            <a class="nav-action" href="#formacoes">Explorar formações <span aria-hidden="true">↗</span></a>
          </nav>
        ) : build ? (
          <nav aria-label="Navegação da Build">
            <a href="#solucoes">Soluções</a>
            <a href="#processo">Como trabalhamos</a>
            <a href="#investimento">Investimento</a>
            <a href="#faq">Dúvidas</a>
            <a class="nav-action" href="#diagnostico">Solicitar diagnóstico <span aria-hidden="true">↗</span></a>
          </nav>
        ) : workforce ? (
          <nav aria-label="Navegação da Workforce">
            <a href="#funcionarios">Funcionários digitais</a>
            <a href="#como-funciona">Como funciona</a>
            <a href="#planos">Contratação</a>
            <a href="#duvidas">Dúvidas</a>
            <a class="nav-action" href="#diagnostico">Montar minha Workforce <span aria-hidden="true">↗</span></a>
          </nav>
        ) : intelligence ? (
          <nav aria-label="Navegação da Intelligence">
            <a href="#visao-geral">Visão geral</a>
            <a href="#como-funciona">Como funciona</a>
            <a href="#aplicacoes">Aplicações</a>
            <a href="#seguranca">Segurança</a>
            <a href="#duvidas">Dúvidas</a>
            <a class="nav-action" href="#diagnostico">Solicitar diagnóstico <span aria-hidden="true">↗</span></a>
          </nav>
        ) : (
          <nav aria-label="Navegação principal">
            <details class="home-nav-menu">
              <summary>Soluções <span aria-hidden="true">⌄</span></summary>
              <div class="home-nav-menu__links">
                <a href="/academy">Academy · Aprenda</a>
                <a href="/build">Build · Construa</a>
                <a href="/workforce">Workforce · Delegue</a>
                <a href="/intelligence">Intelligence · Decida</a>
              </div>
            </details>
            <a href="#como-funciona">Como funciona</a>
            <a href="#por-que-tactia">Por que a Tactia</a>
            <a href="#diagnostico">Contato</a>
            <a class="nav-action" href="#encontre-sua-solucao"><span class="home-nav-action__full">Encontrar minha solução</span><span class="home-nav-action__short">Encontrar</span> <span aria-hidden="true">↗</span></a>
          </nav>
        )}
      </div>
    </header>
    <main id="conteudo"><slot /></main>
    <footer class="workforce-footer">
      <div class="workforce-shell workforce-footer-grid">
        <div>
          <a class="workforce-brand" href={academy ? '/academy' : build ? '/build' : workforce ? '/workforce' : intelligence ? '/intelligence' : '/'} aria-label={academy ? 'Tactia Academy, início' : build ? 'Tactia Build, início' : workforce ? 'Tactia Workforce, início' : intelligence ? 'Tactia Intelligence, início' : 'Tactia, início'}>
            <img src="/tactia-logo-white.svg" alt="Tactia" width="116" height="36" loading="lazy" />
            <span>{academy ? 'ACADEMY' : build ? 'BUILD' : workforce ? 'WORKFORCE' : intelligence ? 'INTELLIGENCE' : home ? 'TACTIA' : 'AI WORKFORCE'}</span>
          </a>
          <p>{academy ? 'Aprendizado prático em IA, automação e tecnologia aplicada a negócios.' : build ? 'Software sob medida para sua operação.' : workforce ? 'Delegue o trabalho. Mantenha o controle.' : intelligence ? 'Dados conectados para entender melhor o negócio.' : home ? 'Tecnologia que trabalha pelo seu negócio.' : 'Forças de trabalho de IA desenhadas para processos reais.'}</p>
        </div>
        {academy ? (
          <div class="footer-links">
            <a href="#formacoes">Formações</a>
            <a href="#como-funciona">Como funciona</a>
            <a href="/">Sobre a Tactia</a>
            <a href="mailto:contato@tactia.com.br">Contato</a>
          </div>
        ) : build ? (
          <div class="footer-links">
            <a href="#solucoes">Soluções</a>
            <a href="#diagnostico">Solicitar diagnóstico</a>
            <a href="/academy">Academy</a>
            <a href="/workforce">Workforce</a>
            <a href="mailto:contato@tactia.com.br">Contato</a>
          </div>
        ) : workforce ? (
          <div class="footer-links">
            <a href="#funcionarios">Funcionários digitais</a>
            <a href="#como-funciona">Como funciona</a>
            <a href="#diagnostico">Solicitar avaliação</a>
            <a href="/academy">Academy</a>
            <a href="/build">Build</a>
          </div>
        ) : intelligence ? (
          <div class="footer-links">
            <a href="#visao-geral">Visão geral</a>
            <a href="#como-funciona">Como funciona</a>
            <a href="#diagnostico">Solicitar diagnóstico</a>
            <a href="/academy">Academy</a>
            <a href="/build">Build</a>
            <a href="/workforce">Workforce</a>
          </div>
        ) : (
          <div class="footer-links">
            <a href="/academy">Tactia Academy</a>
            <a href="/workforce">Tactia Workforce</a>
            <a href="/build">Tactia Build</a>
            <a href="/intelligence">Tactia Intelligence</a>
            <a href="#diagnostico">Contato</a>
          </div>
        )}
        <div class="footer-legal">
          <span>© {new Date().getFullYear()} Tactia</span>
          <a href="mailto:contato@tactia.com.br">contato@tactia.com.br</a>
        </div>
      </div>
    </footer>
  </body>
</html>
