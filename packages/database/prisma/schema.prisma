generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  suspended
  deleted
}

enum OperatorStatus {
  active
  disabled
}

enum MembershipRole {
  owner
  admin
  member
  viewer
}

enum MembershipStatus {
  active
  invited
  suspended
  removed
}

enum CustomerStatus {
  active
  inactive
  blocked
}

enum LeadStatus {
  new
  contacted
  qualified
  proposal
  won
  lost
}

enum ProductStatus {
  active
  inactive
  discontinued
}

enum SellerStatus {
  active
  inactive
}

enum SaleStatus {
  pending
  confirmed
  cancelled
  refunded
}

enum ActivityType {
  call
  email
  meeting
  message
  note
  task
  proposal
  status_change
}

enum DataSourceStatus {
  active
  inactive
  error
}

enum SyncJobStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum ImportStatus {
  pending
  processing
  completed
  failed
}

enum InsightType {
  anomaly
  performance
  opportunity
  warning
}

enum InsightSeverity {
  low
  medium
  high
  critical
}

enum InsightStatus {
  open
  acknowledged
  resolved
  dismissed
}

enum RecommendationPriority {
  low
  medium
  high
}

enum MessageRole {
  user
  assistant
  system
  tool
}

enum ActionType {
  create_task
  send_email
  send_whatsapp
  generate_report
}

enum ActionExecutionStatus {
  pending
  awaiting_approval
  approved
  running
  completed
  failed
  cancelled
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum EpisodeKind {
  decision
  action_outcome
  event
}

enum EpisodeOutcome {
  approved
  rejected
  executed
  failed
  cancelled
}

enum RecommendationStatus {
  pending
  accepted
  rejected
  dismissed
}

enum InteractionChannel {
  whatsapp
  email
  note
  other
}

enum InteractionDirection {
  inbound
  outbound
  internal
}

enum InteractionIntent {
  complaint
  praise
  question
  purchase_intent
  cancellation_intent
  price_objection
  delivery_issue
  support
  other
}

enum InteractionUrgency {
  low
  medium
  high
}

enum KnowledgeDocumentStatus {
  pending
  processing
  ready
  failed
}

enum KnowledgeDocumentKind {
  policy
  playbook_doc
  contract
  other
}

enum MediaAssetStatus {
  pending
  processing
  ready
  failed
}

enum MediaAssetPurpose {
  knowledge
  interaction
  auto
}

// ---------------------------------------------------------------------------
// Better Auth tables (provider-owned). Domain User maps via externalAuthId.
// ---------------------------------------------------------------------------

model AuthUser {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      AuthSession[]
  accounts      AuthAccount[]
  domainUser    User?

  @@unique([email])
  @@map("auth_users")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id
  issuer                String    @default("credential")
  accountId             String
  providerId            String
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

// ---------------------------------------------------------------------------
// Operator identity (backoffice). Separate Better Auth tables so a client
// credential can never become an operator session and vice versa.
// ---------------------------------------------------------------------------

model OperatorAuthUser {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      OperatorAuthSession[]
  accounts      OperatorAuthAccount[]
  domainOperator Operator?

  @@unique([email])
  @@map("operator_auth_users")
}

model OperatorAuthSession {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      OperatorAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("operator_auth_sessions")
}

model OperatorAuthAccount {
  id                    String    @id
  issuer                String    @default("credential")
  accountId             String
  providerId            String
  userId                String
  user                  OperatorAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("operator_auth_accounts")
}

model OperatorAuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("operator_auth_verifications")
}

model Operator {
  id             String         @id @db.Uuid
  externalAuthId String         @unique @map("external_auth_id")
  name           String
  email          String
  status         OperatorStatus @default(active)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  authUser       OperatorAuthUser @relation(fields: [externalAuthId], references: [id], onDelete: Restrict)
  auditLogs      AuditLog[]

  @@unique([email])
  @@index([status])
  @@index([createdAt])
  @@map("operators")
}

// ---------------------------------------------------------------------------
// Domain identity
// ---------------------------------------------------------------------------

model Tenant {
  id           String       @id @db.Uuid
  name         String
  slug         String
  status       TenantStatus @default(active)
  timezone     String       @default("America/Sao_Paulo")
  currency     String       @default("BRL")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  memberships  Membership[]
  auditLogs    AuditLog[]
  customers    Customer[]
  leads        Lead[]
  products     Product[]
  sellers      Seller[]
  sales        Sale[]
  saleItems    SaleItem[]
  activities   Activity[]
  interactions Interaction[]
  credentials  Credential[]
  dataSources  DataSource[]
  syncJobs     SyncJob[]
  rawRecords   RawRecord[]
  mappings     Mapping[]
  imports      Import[]
  qualityReports DataQualityReport[]
  metrics        Metric[]
  metricSnapshots MetricSnapshot[]
  insights       Insight[]
  recommendations Recommendation[]
  briefings      Briefing[]
  goals          Goal[]
  businessFacts  BusinessFact[]
  tenantSettings TenantSettings?
  expenses       Expense[]
  payments       Payment[]
  inventoryLevels InventoryLevel[]
  campaigns      Campaign[]
  leadStageTransitions LeadStageTransition[]
  conversations  Conversation[]
  actions          Action[]
  actionExecutions ActionExecution[]
  approvals        Approval[]
  episodes         Episode[]
  playbooks        Playbook[]
  knowledgeDocuments KnowledgeDocument[]
  documentChunks     DocumentChunk[]
  mediaAssets        MediaAsset[]
  infographicAssets  InfographicAsset[]
  apiKeys            TenantApiKey[]
  whatsappNumbers    WhatsappAuthorizedNumber[]
  customFieldDefinitions CustomFieldDefinition[]

  @@unique([slug])
  @@index([status])
  @@index([createdAt])
  @@map("tenants")
}

model User {
  id             String       @id @db.Uuid
  externalAuthId String       @unique @map("external_auth_id")
  name           String
  email          String
  avatarUrl      String?      @map("avatar_url")
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  authUser       AuthUser     @relation(fields: [externalAuthId], references: [id], onDelete: Restrict)
  memberships    Membership[]
  auditLogs      AuditLog[]
  sellers        Seller[]
  conversations  Conversation[]
  insightFeedbacks InsightFeedback[]
  businessFacts  BusinessFact[]
  createdApiKeys TenantApiKey[]
  whatsappNumbers WhatsappAuthorizedNumber[]

  @@index([email])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

model Membership {
  id        String           @id @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      MembershipRole
  status    MembershipStatus @default(active)
  deletedAt DateTime?        @map("deleted_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId])
  @@index([tenantId, createdAt])
  @@index([deletedAt])
  @@map("memberships")
}

model TenantApiKey {
  id         String          @id @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  name       String
  prefix     String
  hash       String
  scopes     String[]        @default(["tools:read"])
  role       MembershipRole
  createdBy  String          @map("created_by") @db.Uuid
  lastUsedAt DateTime?       @map("last_used_at")
  revokedAt  DateTime?       @map("revoked_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator    User            @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([prefix])
  @@index([tenantId, revokedAt])
  @@map("tenant_api_keys")
}

model WhatsappAuthorizedNumber {
  id                   String    @id @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  phone                String
  label                String?
  conversationId       String?   @map("conversation_id") @db.Uuid
  lastInboundMessageId String?   @map("last_inbound_message_id")
  disabledAt           DateTime? @map("disabled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation         Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([phone])
  @@index([tenantId, disabledAt])
  @@index([userId])
  @@map("whatsapp_authorized_numbers")
}

model AuditLog {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  operatorId String?  @map("operator_id") @db.Uuid
  actorType  String   @map("actor_type")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, entityType, entityId])
  @@index([userId])
  @@index([operatorId])
  @@map("audit_logs")
}

model CustomFieldDefinition {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  entityType  String   @map("entity_type")
  fieldKey    String   @map("field_key")
  label       String
  fieldType   String   @map("field_type")
  description String?
  required    Boolean  @default(false)
  config      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, fieldKey])
  @@index([tenantId, entityType])
  @@map("custom_field_definitions")
}

// ---------------------------------------------------------------------------
// Canonical business data (Etapa 2)
// data_source_id is nullable until DataSource lands in Etapa 3.
// ---------------------------------------------------------------------------

model Customer {
  id           String         @id @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  dataSourceId String?        @map("data_source_id") @db.Uuid
  externalId   String?        @map("external_id")
  name         String
  email        String?
  phone        String?
  document     String?
  segment      String?
  city         String?
  state        String?
  acquisitionSource String? @map("acquisition_source")
  status       CustomerStatus @default(active)
  metadata     Json?
  customData   Json           @default("{}") @map("custom_data")
  /// Written via raw SQL (pgvector). Never selected through Prisma.
  embedding    Unsupported("vector")?
  embeddedAt   DateTime?      @map("embedded_at")
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads        Lead[]
  sales        Sale[]
  activities   Activity[]
  interactions Interaction[]

  @@unique([tenantId, dataSourceId, externalId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, externalId])
  @@index([tenantId, email])
  @@index([deletedAt])
  @@index([customData], type: Gin, map: "customers_custom_data_idx")
  @@map("customers")
}

model Lead {
  id           String     @id @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  dataSourceId String?    @map("data_source_id") @db.Uuid
  externalId   String?    @map("external_id")
  customerId   String?    @map("customer_id") @db.Uuid
  name         String
  email        String?
  phone        String?
  source       String?
  status       LeadStatus @default(new)
  score        Int?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  sellerId     String?    @map("seller_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  seller       Seller?    @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  activities   Activity[]
  stageTransitions LeadStageTransition[]

  @@unique([tenantId, dataSourceId, externalId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, externalId])
  @@index([tenantId, customerId])
  @@map("leads")
}

model Product {
  id           String        @id @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  dataSourceId String?       @map("data_source_id") @db.Uuid
  externalId   String?       @map("external_id")
  name         String
  sku          String?
  category     String?
  supplier     String?
  cost         Decimal?      @db.Decimal(18, 4)
  price        Decimal?      @db.Decimal(18, 4)
  status       ProductStatus @default(active)
  metadata     Json?
  customData   Json           @default("{}") @map("custom_data")
  /// Written via raw SQL (pgvector). Never selected through Prisma.
  embedding    Unsupported("vector")?
  embeddedAt   DateTime?     @map("embedded_at")
  deletedAt    DateTime?     @map("deleted_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleItems    SaleItem[]
  interactions Interaction[]
  inventoryLevels InventoryLevel[]

  @@unique([tenantId, dataSourceId, externalId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, externalId])
  @@index([tenantId, sku])
  @@index([deletedAt])
  @@index([customData], type: Gin, map: "products_custom_data_idx")
  @@map("products")
}

model Seller {
  id           String       @id @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  dataSourceId String?      @map("data_source_id") @db.Uuid
  externalId   String?      @map("external_id")
  userId       String?      @map("user_id") @db.Uuid
  name         String
  email        String?
  status       SellerStatus @default(active)
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  sales        Sale[]
  activities   Activity[]
  leads        Lead[]

  @@unique([tenantId, dataSourceId, externalId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, externalId])
  @@index([tenantId, userId])
  @@index([deletedAt])
  @@map("sellers")
}

model Sale {
  id             String     @id @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  dataSourceId   String?    @map("data_source_id") @db.Uuid
  externalId     String?    @map("external_id")
  customerId     String     @map("customer_id") @db.Uuid
  sellerId       String?    @map("seller_id") @db.Uuid
  totalAmount    Decimal    @map("total_amount") @db.Decimal(18, 4)
  discountAmount Decimal    @default(0) @map("discount_amount") @db.Decimal(18, 4)
  currency       String     @default("BRL") @db.Char(3)
  status         SaleStatus @default(confirmed)
  paymentMethod  String?    @map("payment_method")
  channel        String?
  region         String?
  soldAt         DateTime   @map("sold_at")
  metadata       Json?
  customData     Json       @default("{}") @map("custom_data")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  seller         Seller?    @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  payments       Payment[]

  @@unique([tenantId, dataSourceId, externalId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, soldAt])
  @@index([tenantId, externalId])
  @@index([tenantId, customerId])
  @@index([tenantId, sellerId])
  @@index([customData], type: Gin, map: "sales_custom_data_idx")
  @@map("sales")
}

model SaleItem {
  id             String  @id @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  saleId         String  @map("sale_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  quantity       Decimal @db.Decimal(18, 4)
  unitPrice      Decimal @map("unit_price") @db.Decimal(18, 4)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(18, 4)
  totalAmount    Decimal @map("total_amount") @db.Decimal(18, 4)
  customData     Json    @default("{}") @map("custom_data")
  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, saleId])
  @@index([tenantId, productId])
  @@index([customData], type: Gin, map: "sale_items_custom_data_idx")
  @@map("sale_items")
}

model Activity {
  id           String       @id @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  dataSourceId String?      @map("data_source_id") @db.Uuid
  externalId   String?      @map("external_id")
  type         ActivityType
  customerId   String?      @map("customer_id") @db.Uuid
  leadId       String?      @map("lead_id") @db.Uuid
  sellerId     String?      @map("seller_id") @db.Uuid
  occurredAt   DateTime     @map("occurred_at")
  metadata     Json?
  createdAt  DateTime     @default(now()) @map("created_at")
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  seller     Seller?      @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([tenantId, type])
  @@index([tenantId, occurredAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, leadId])
  @@index([tenantId, sellerId])
  @@unique([tenantId, dataSourceId, externalId])
  @@map("activities")
}

model Interaction {
  id           String               @id @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  dataSourceId String?              @map("data_source_id") @db.Uuid
  externalId   String?              @map("external_id")
  customerId   String?              @map("customer_id") @db.Uuid
  channel      InteractionChannel
  direction    InteractionDirection @default(inbound)
  subject      String?
  body         String
  occurredAt   DateTime             @map("occurred_at")
  intent       InteractionIntent?
  topics       String[]             @default([])
  /// -1 (very negative) .. 1 (very positive), set by the classifier.
  sentiment    Decimal?             @db.Decimal(3, 2)
  urgency      InteractionUrgency?
  /// Product the message is about, when the classifier can link it.
  productId    String?              @map("product_id") @db.Uuid
  /// Written via raw SQL (pgvector). Never selected through Prisma.
  embedding    Unsupported("vector")?
  metadata     Json?
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product      Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([tenantId, dataSourceId, externalId])
  @@index([tenantId, occurredAt])
  @@index([tenantId, customerId])
  @@index([tenantId, intent, occurredAt])
  @@index([tenantId, channel])
  @@index([tenantId, dataSourceId])
  @@index([tenantId, productId])
  @@index([tenantId, urgency, occurredAt])
  @@map("interactions")
}

// ---------------------------------------------------------------------------
// Data Platform (Etapa 3)
// ---------------------------------------------------------------------------

model Credential {
  id            String       @id @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  provider      String
  encryptedData String       @map("encrypted_data")
