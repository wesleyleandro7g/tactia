generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  suspended
  deleted
}

enum MembershipRole {
  owner
  admin
  member
  viewer
}

enum MembershipStatus {
  active
  invited
  suspended
  removed
}

enum CustomerStatus {
  active
  inactive
  blocked
}

enum LeadStatus {
  new
  contacted
  qualified
  proposal
  won
  lost
}

enum ProductStatus {
  active
  inactive
  discontinued
}

enum SellerStatus {
  active
  inactive
}

enum SaleStatus {
  pending
  confirmed
  cancelled
  refunded
}

enum ActivityType {
  call
  email
  meeting
  message
  note
  task
  proposal
  status_change
}

enum DataSourceType {
  csv
  xlsx
  postgres
  rest
  google_sheets
}

enum DataSourceStatus {
  active
  inactive
  error
}

enum SyncJobStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum ImportStatus {
  pending
  processing
  completed
  failed
}

// ---------------------------------------------------------------------------
// Better Auth tables (provider-owned). Domain User maps via externalAuthId.
// ---------------------------------------------------------------------------

model AuthUser {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      AuthSession[]
  accounts      AuthAccount[]
  domainUser    User?

  @@unique([email])
  @@map("auth_users")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id
  issuer                String    @default("credential")
  accountId             String
  providerId            String
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

// ---------------------------------------------------------------------------
// Domain identity
// ---------------------------------------------------------------------------

model Tenant {
  id           String       @id @db.Uuid
  name         String
  slug         String
  status       TenantStatus @default(active)
  timezone     String       @default("America/Sao_Paulo")
  currency     String       @default("BRL")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  memberships  Membership[]
  auditLogs    AuditLog[]
  customers    Customer[]
  leads        Lead[]
  products     Product[]
  sellers      Seller[]
  sales        Sale[]
  saleItems    SaleItem[]
  activities   Activity[]
  credentials  Credential[]
  dataSources  DataSource[]
  syncJobs     SyncJob[]
  rawRecords   RawRecord[]
  mappings     Mapping[]
  imports      Import[]
  qualityReports DataQualityReport[]
  metrics        Metric[]

  @@unique([slug])
  @@index([status])
  @@index([createdAt])
  @@map("tenants")
}

model User {
  id             String       @id @db.Uuid
  externalAuthId String       @unique @map("external_auth_id")
  name           String
  email          String
  avatarUrl      String?      @map("avatar_url")
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  authUser       AuthUser     @relation(fields: [externalAuthId], references: [id], onDelete: Restrict)
  memberships    Membership[]
  auditLogs      AuditLog[]
  sellers        Seller[]

  @@index([email])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

model Membership {
  id        String           @id @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      MembershipRole
  status    MembershipStatus @default(active)
  deletedAt DateTime?        @map("deleted_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId])
  @@index([tenantId, createdAt])
  @@index([deletedAt])
  @@map("memberships")
}

model AuditLog {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  actorType  String   @map("actor_type")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Canonical business data (Etapa 2)
// data_source_id is nullable until DataSource lands in Etapa 3.
// ---------------------------------------------------------------------------

model Customer {
  id           String         @id @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  dataSourceId String?        @map("data_source_id") @db.Uuid
  externalId   String?        @map("external_id")
  name         String
  email        String?
  phone        String?
  document     String?
  status       CustomerStatus @default(active)
  metadata     Json?
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads        Lead[]
  sales        Sale[]
  activities   Activity[]

  @@unique([tenantId, dataSourceId, externalId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, externalId])
  @@index([tenantId, email])
  @@index([deletedAt])
  @@map("customers")
}

model Lead {
  id           String     @id @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  dataSourceId String?    @map("data_source_id") @db.Uuid
  externalId   String?    @map("external_id")
  customerId   String?    @map("customer_id") @db.Uuid
  name         String
  email        String?
  phone        String?
  source       String?
  status       LeadStatus @default(new)
  score        Int?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  activities   Activity[]

  @@unique([tenantId, dataSourceId, externalId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, externalId])
  @@index([tenantId, customerId])
  @@map("leads")
}

model Product {
  id           String        @id @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  dataSourceId String?       @map("data_source_id") @db.Uuid
  externalId   String?       @map("external_id")
  name         String
  sku          String?
  category     String?
  cost         Decimal?      @db.Decimal(18, 4)
  price        Decimal?      @db.Decimal(18, 4)
  status       ProductStatus @default(active)
  metadata     Json?
  deletedAt    DateTime?     @map("deleted_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleItems    SaleItem[]

  @@unique([tenantId, dataSourceId, externalId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, externalId])
  @@index([tenantId, sku])
  @@index([deletedAt])
  @@map("products")
}

model Seller {
  id           String       @id @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  dataSourceId String?      @map("data_source_id") @db.Uuid
  externalId   String?      @map("external_id")
  userId       String?      @map("user_id") @db.Uuid
  name         String
  email        String?
  status       SellerStatus @default(active)
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  sales        Sale[]
  activities   Activity[]

  @@unique([tenantId, dataSourceId, externalId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, externalId])
  @@index([tenantId, userId])
  @@index([deletedAt])
  @@map("sellers")
}

model Sale {
  id             String     @id @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  dataSourceId   String?    @map("data_source_id") @db.Uuid
  externalId     String?    @map("external_id")
  customerId     String     @map("customer_id") @db.Uuid
  sellerId       String?    @map("seller_id") @db.Uuid
  totalAmount    Decimal    @map("total_amount") @db.Decimal(18, 4)
  discountAmount Decimal    @default(0) @map("discount_amount") @db.Decimal(18, 4)
  currency       String     @default("BRL") @db.Char(3)
  status         SaleStatus @default(confirmed)
  soldAt         DateTime   @map("sold_at")
  metadata       Json?
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  seller         Seller?    @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  items          SaleItem[]

  @@unique([tenantId, dataSourceId, externalId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, soldAt])
  @@index([tenantId, externalId])
  @@index([tenantId, customerId])
  @@index([tenantId, sellerId])
  @@map("sales")
}

model SaleItem {
  id             String  @id @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  saleId         String  @map("sale_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  quantity       Decimal @db.Decimal(18, 4)
  unitPrice      Decimal @map("unit_price") @db.Decimal(18, 4)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(18, 4)
  totalAmount    Decimal @map("total_amount") @db.Decimal(18, 4)
  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, saleId])
  @@index([tenantId, productId])
  @@map("sale_items")
}

model Activity {
  id         String       @id @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  type       ActivityType
  customerId String?      @map("customer_id") @db.Uuid
  leadId     String?      @map("lead_id") @db.Uuid
  sellerId   String?      @map("seller_id") @db.Uuid
  occurredAt DateTime     @map("occurred_at")
  metadata   Json?
  createdAt  DateTime     @default(now()) @map("created_at")
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  seller     Seller?      @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([tenantId, type])
  @@index([tenantId, occurredAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, leadId])
  @@index([tenantId, sellerId])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Data Platform (Etapa 3)
// ---------------------------------------------------------------------------

model Credential {
  id            String       @id @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  provider      String
  encryptedData String       @map("encrypted_data")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dataSources   DataSource[]

  @@index([tenantId])
  @@map("credentials")
}

model DataSource {
  id           String           @id @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  type         DataSourceType
  name         String
  status       DataSourceStatus @default(active)
  configuration Json?
  credentialId  String?          @map("credential_id") @db.Uuid
  lastSyncAt   DateTime?        @map("last_sync_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credential   Credential?      @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  syncJobs     SyncJob[]
  rawRecords   RawRecord[]
  mappings     Mapping[]
  imports      Import[]
  qualityReports DataQualityReport[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("data_sources")
}

model SyncJob {
  id              String        @id @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  dataSourceId    String        @map("data_source_id") @db.Uuid
  status          SyncJobStatus @default(pending)
  startedAt       DateTime?     @map("started_at")
  finishedAt      DateTime?     @map("finished_at")
  recordsRead     Int           @default(0) @map("records_read")
  recordsCreated  Int           @default(0) @map("records_created")
  recordsUpdated  Int           @default(0) @map("records_updated")
  recordsFailed   Int           @default(0) @map("records_failed")
  error           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dataSource      DataSource    @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  rawRecords      RawRecord[]
  imports         Import[]
  qualityReports  DataQualityReport[]

  @@index([tenantId, status])
  @@index([tenantId, dataSourceId])
  @@index([tenantId, createdAt])
  @@map("sync_jobs")
}

model RawRecord {
  id           String     @id @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  dataSourceId String     @map("data_source_id") @db.Uuid
  syncJobId    String?    @map("sync_job_id") @db.Uuid
  externalId   String?    @map("external_id")
  entityType   String     @map("entity_type")
  payload      Json
  checksum     String
  processedAt  DateTime?  @map("processed_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  syncJob      SyncJob?   @relation(fields: [syncJobId], references: [id], onDelete: SetNull)

  @@unique([tenantId, dataSourceId, externalId, entityType])
  @@index([tenantId, dataSourceId])
  @@index([tenantId, entityType])
  @@index([tenantId, externalId])
  @@map("raw_records")
}

model Mapping {
  id            String     @id @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  dataSourceId  String     @map("data_source_id") @db.Uuid
  sourceEntity  String     @map("source_entity")
  targetEntity  String     @map("target_entity")
  configuration Json
  version       Int        @default(1)
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dataSource    DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@index([tenantId, dataSourceId])
  @@index([tenantId, targetEntity])
  @@map("mappings")
}

model Import {
  id               String       @id @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  dataSourceId     String       @map("data_source_id") @db.Uuid
  syncJobId        String?      @map("sync_job_id") @db.Uuid
  entityType       String       @map("entity_type")
  status           ImportStatus @default(pending)
  totalRecords     Int          @default(0) @map("total_records")
  processedRecords Int          @default(0) @map("processed_records")
  failedRecords    Int          @default(0) @map("failed_records")
  idempotencyKey   String?      @unique @map("idempotency_key")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dataSource       DataSource   @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  syncJob          SyncJob?     @relation(fields: [syncJobId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, dataSourceId])
  @@index([tenantId, createdAt])
  @@map("imports")
}

model DataQualityReport {
  id           String     @id @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  dataSourceId String     @map("data_source_id") @db.Uuid
  syncJobId    String?    @map("sync_job_id") @db.Uuid
  entityType   String     @map("entity_type")
  totalRecords Int        @map("total_records")
  validRecords Int        @map("valid_records")
  invalidRecords Int      @map("invalid_records")
  warnings     Json
  errors       Json
  createdAt    DateTime   @default(now()) @map("created_at")
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  syncJob      SyncJob?   @relation(fields: [syncJobId], references: [id], onDelete: SetNull)

  @@index([tenantId, dataSourceId])
  @@index([tenantId, createdAt])
  @@map("data_quality_reports")
}

// ---------------------------------------------------------------------------
// Intelligence — Metric Engine (Etapa 4)
// ---------------------------------------------------------------------------

model Metric {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  definition  Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("metrics")
}
