  uploadedBy String?                 @map("uploaded_by") @db.Uuid
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")
  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks     DocumentChunk[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@unique([tenantId, checksum])
  @@map("knowledge_documents")
}

model DocumentChunk {
  id         String            @id @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  documentId String            @map("document_id") @db.Uuid
  ordinal    Int
  heading    String?
  page       Int?
  text       String
  tokenCount Int               @map("token_count")
  /// Written via raw SQL (pgvector). Never selected through Prisma.
  embedding  Unsupported("vector")?
  embeddedAt DateTime?         @map("embedded_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([tenantId, documentId])
  @@map("document_chunks")
}

model MediaAsset {
  id             String            @id @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  purpose        MediaAssetPurpose @default(auto)
  mime           String
  storageKey     String            @map("storage_key")
  checksum       String
  byteSize       Int               @map("byte_size")
  status         MediaAssetStatus  @default(pending)
  error          String?
  classification String?
  resultKind     String?           @map("result_kind")
  resultId       String?           @map("result_id") @db.Uuid
  uploadedBy     String?           @map("uploaded_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("media_assets")
}

model InfographicAsset {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  title      String
  template   String
  mime       String
  storageKey String   @map("storage_key")
  byteSize   Int      @map("byte_size")
  width      Int
  height     Int
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("infographic_assets")
}
