---
import LeadForm from '../components/LeadForm.astro';
import SiteLayout from '../components/SiteLayout.astro';
import '../styles/academy.css';

const audiences = [
  ['01', 'Empresários e gestores', 'Encontre oportunidades de automação e aprenda a conduzir projetos de IA na operação.'],
  ['02', 'Profissionais de tecnologia', 'Amplie seu repertório em agentes, integrações e soluções orientadas a problemas reais.'],
  ['03', 'Profissionais de outras áreas', 'Redesenhe tarefas, ganhe autonomia e proponha melhorias relevantes no trabalho.'],
  ['04', 'Quem quer empreender', 'Explore métodos para prototipar soluções e criar serviços com aplicações práticas de IA.'],
];

const plannedTracks = [
  ['IA na Prática', 'Entenda os fundamentos e use IA com intenção no trabalho e nos negócios.'],
  ['Automação de Processos', 'Identifique rotinas repetitivas e construa fluxos que conectam ferramentas.'],
  ['Agentes e Integrações', 'Avance de comandos isolados para sistemas capazes de usar ferramentas e dados.'],
  ['IA para Negócios', 'Priorize oportunidades, estime viabilidade e acompanhe o impacto das soluções.'],
];

const questions = [
  ['Preciso saber programar para aprender na Tactia Academy?', 'Não necessariamente. A proposta contempla diferentes níveis; os pré-requisitos de cada formação serão informados antes da inscrição.'],
  ['A Academy é um curso ou uma plataforma?', 'É uma proposta de plataforma de aprendizado com cursos, trilhas e materiais em diferentes formatos. A disponibilidade de cada recurso dependerá da oferta apresentada.'],
  ['Vou aprender a criar agentes de IA?', 'Esse é um dos temas centrais. A primeira formação planejada, Crie sua AI Workforce, aborda o planejamento de agentes e rotinas automatizadas.'],
  ['O conteúdo é para empresários ou desenvolvedores?', 'Para ambos, além de gestores e profissionais de outras áreas. O nível técnico e os pré-requisitos serão indicados em cada formação.'],
  ['Posso aplicar o que aprender na minha empresa?', 'A proposta é ensinar métodos e ferramentas com aplicações práticas. A viabilidade de cada automação depende dos sistemas, dados, permissões e processos envolvidos.'],
  ['Comunidade e mentoria estão incluídas?', 'Não há inclusão automática. Esses formatos estão em preparação e, quando disponíveis, terão condições de acesso e duração informadas separadamente.'],
  ['A Tactia cria ou opera a solução para mim?', 'Na Academy você aprende a desenvolver soluções. Implementação e operação são serviços separados da Tactia Build e da Tactia Workforce.'],
  ['Quanto custa? Há certificado ou prazo de acesso definido?', 'Preço, condições de pagamento, prazo de acesso, atualizações e eventual certificado serão divulgados na oferta de cada formação antes de qualquer compra.'],
];
---

<SiteLayout
  title="Tactia Academy | Aprenda IA, Automações e Agentes na Prática"
  description="Aprenda a aplicar inteligência artificial, criar agentes, automatizar processos e integrar ferramentas com formações e projetos práticos na Tactia Academy."
  canonicalPath="/curso-ai-workforce"
  theme="dark"
  academy
>
  <section class="academy-hero academy-shell" aria-labelledby="academy-title">
    <div class="academy-hero__copy">
      <p class="academy-label"><span class="academy-spark" aria-hidden="true">✳</span> TACTIA ACADEMY · APRENDIZADO PARA O MUNDO REAL</p>
      <h1 id="academy-title">Pare de apenas usar IA. <em>Aprenda a colocá-la para trabalhar.</em></h1>
      <p class="academy-hero__intro">Aprenda a criar agentes de IA, automatizar processos, conectar ferramentas e desenvolver soluções que fazem diferença no dia a dia. Estamos preparando formações e materiais para levar o aprendizado à prática.</p>
      <div class="academy-actions">
        <a class="academy-button" href="#formacoes" data-academy-event="academy_hero_cta_click">Explorar formações <span aria-hidden="true">↗</span></a>
        <a class="academy-link" href="#como-funciona">Ver como funciona <span aria-hidden="true">↘</span></a>
      </div>
      <p class="academy-hero__note">Para quem está começando e para quem quer construir soluções mais avançadas.</p>
    </div>
    <div class="academy-preview" aria-label="Ilustração conceitual da jornada de aprendizado da Academy">
      <div class="academy-preview__top"><span>ACADEMY / VISÃO DE APRENDIZADO</span><span aria-hidden="true">● ● ●</span></div>
      <div class="academy-preview__body">
        <p class="academy-preview__eyebrow">UM CAMINHO PARA CONSTRUIR</p>
        <div class="academy-preview__title">Da pergunta<br />ao projeto<span>.</span></div>
        <div class="academy-preview__flow" aria-hidden="true"><span>ENTENDER</span><i></i><span>DESENHAR</span><i></i><span>TESTAR</span><i></i><span>EVOLUIR</span></div>
        <div class="academy-preview__lesson"><span class="academy-preview__play" aria-hidden="true">▶</span><div><small>EXEMPLO DE PROJETO</small><strong>Uma rotina que trabalha com você</strong><p>Dados → validação → resumo → revisão</p></div><span class="academy-preview__arrow" aria-hidden="true">↗</span></div>
      </div>
      <div class="academy-preview__bottom"><span>AGENTES DE IA</span><span>AUTOMAÇÕES</span><span>INTEGRAÇÕES</span><span>NEGÓCIOS</span></div>
      <p class="academy-preview__caption">Representação conceitual da experiência planejada. Não é uma captura da plataforma.</p>
    </div>
  </section>

  <div class="academy-ticker" aria-hidden="true"><div class="academy-shell">APRENDA O NECESSÁRIO <span>✳</span> CONSTRUA ALGO ÚTIL <span>✳</span> EVOLUA COM CRITÉRIO <span>✳</span> APLIQUE NO MUNDO REAL</div></div>

  <section class="academy-section academy-problem academy-shell" aria-labelledby="problem-title">
    <div class="academy-heading"><p class="academy-label">01 / O PROBLEMA NÃO É FALTA DE FERRAMENTAS</p><h2 id="problem-title">Você já tem acesso à IA. O que falta é saber <em>o que construir com ela.</em></h2><p>Conhecer ferramentas não é o mesmo que resolver problemas. O valor aparece quando você enxerga um processo, desenha uma solução e a coloca em prática.</p></div>
    <div class="academy-problem__grid">
      <article><span>01 / CONTEÚDO</span><h3>Muito conteúdo.<br />Pouca direção.</h3><p>Recursos isolados não se transformam sozinhos em um projeto útil.</p></article>
      <article><span>02 / PROCESSOS</span><h3>Muitas tarefas.<br />Pouca integração.</h3><p>Equipes continuam copiando dados e repetindo rotinas que poderiam ser redesenhadas.</p></article>
      <article><span>03 / EXECUÇÃO</span><h3>Muitas ideias.<br />Pouca execução.</h3><p>Sem um caminho claro, bons experimentos raramente chegam à operação.</p></article>
    </div>
    <p class="academy-problem__closer">A Academy foi pensada para encurtar a distância entre <strong>descobrir uma tecnologia</strong> e <strong>saber aplicá-la.</strong></p>
  </section>

  <section class="academy-section academy-about" aria-labelledby="about-title"><div class="academy-shell">
    <div class="academy-heading academy-heading--split"><div><p class="academy-label">02 / MUITO ALÉM DE UM CURSO</p><h2 id="about-title">Um espaço para aprender, experimentar e <em>evoluir com IA.</em></h2></div><p>A proposta da Tactia Academy reúne formatos de aprendizado para acompanhar sua evolução: fundamentos, temas específicos e projetos relacionados ao seu trabalho ou negócio.</p></div>
    <div class="academy-resources">
      <article class="academy-resources__feature"><span class="academy-resources__number">01 / FORMAÇÕES</span><div class="academy-resources__glyph" aria-hidden="true"><span>APRENDER</span><span>PRATICAR</span><span>APLICAR</span></div><h3>Um caminho claro para evoluir.</h3><p>Conteúdos organizados por objetivo e nível, com foco em problemas que vale a pena resolver.</p></article>
      <article><span class="academy-resources__number">02 / PROJETOS</span><h3>Aprenda construindo.</h3><p>Exemplos práticos que conectam conceitos a situações reais.</p></article>
      <article><span class="academy-resources__number">03 / MATERIAIS</span><h3>Conhecimento para consultar.</h3><p>Guias, modelos e referências conforme a disponibilidade de cada formação.</p></article>
      <article><span class="academy-resources__number">04 / FORMATOS</span><h3>Aprenda do seu jeito.</h3><p>Aulas e materiais planejados para explicar, demonstrar e apoiar a prática.</p></article>
    </div>
    <a class="academy-link academy-link--dark" href="#formacoes">Conhecer as formações <span aria-hidden="true">↗</span></a>
  </div></section>

  <section id="para-quem" class="academy-section academy-audience academy-shell" aria-labelledby="audience-title"><div class="academy-heading academy-heading--split"><div><p class="academy-label">03 / PARA QUEM QUER ENTRAR NA PRÁTICA</p><h2 id="audience-title">Seu próximo passo começa com <em>um problema real.</em></h2></div><p>Não importa se você lidera uma empresa ou desenvolve soluções: aprender a aplicar tecnologia começa pelo contexto em que ela vai trabalhar.</p></div><div class="academy-audience__grid">{audiences.map(([number, title, text]) => <article><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div><a class="academy-link" href="#formacoes">Encontrar minha trilha <span aria-hidden="true">↗</span></a></section>

  <section id="formacoes" class="academy-section academy-catalog" aria-labelledby="catalog-title"><div class="academy-shell">
    <div class="academy-heading academy-heading--split"><div><p class="academy-label">04 / ESCOLHA O QUE VOCÊ QUER CONSTRUIR</p><h2 id="catalog-title">Da sua primeira automação à sua própria <em>AI Workforce.</em></h2></div><p>Aprenda por objetivo, não por modismo. Confira o que está sendo preparado e registre seu interesse para saber quando as primeiras formações abrirem.</p></div>
    <article class="academy-featured"><div class="academy-featured__content"><div class="academy-featured__meta"><span>FORMAÇÃO EM PREPARAÇÃO</span><span>01 / DESTAQUE</span></div><p class="academy-featured__overline">COMECE POR AQUI</p><h3>Crie sua<br /><em>AI Workforce.</em></h3><p class="academy-featured__summary">Aprenda a planejar, criar e operar seus próprios funcionários digitais: do processo à rotina supervisionada.</p><ul><li>Mapeamento de tarefas e definição de escopo</li><li>Agentes, ferramentas e automações</li><li>Integrações, dados e permissões</li><li>Testes, monitoramento e limites de autonomia</li></ul><a class="academy-button" href="#academy-interest" data-academy-event="academy_course_click">Quero ser avisado <span aria-hidden="true">↗</span></a><p class="academy-featured__fine">Conteúdo, condições de acesso e preço serão informados antes da abertura.</p></div><div class="academy-featured__diagram" aria-label="Diagrama ilustrativo: processo, agente, supervisão e melhoria"><div class="academy-diagram__orbit"><span class="academy-diagram__core">AI<br />WORKFORCE</span><span class="academy-diagram__node academy-diagram__node--one">01 · PROCESSO</span><span class="academy-diagram__node academy-diagram__node--two">02 · AGENTE</span><span class="academy-diagram__node academy-diagram__node--three">03 · SUPERVISÃO</span><span class="academy-diagram__node academy-diagram__node--four">04 · MELHORIA</span></div><p>DA IDEIA À ROTINA / COM CRITÉRIO</p></div></article>
    <div class="academy-tracks"><div class="academy-tracks__intro"><span>OUTROS CAMINHOS</span><p>Temas editoriais em planejamento. Ainda não são formações disponíveis.</p></div>{plannedTracks.map(([title, description], index) => <article><span class="academy-tracks__index">0{index + 2}</span><div><h3>{title}</h3><p>{description}</p></div><span class="academy-tracks__status">Em planejamento</span></article>)}</div>
  </div></section>

  <section id="como-funciona" class="academy-section academy-method academy-shell" aria-labelledby="method-title"><div class="academy-heading academy-heading--split"><div><p class="academy-label">05 / MENOS TEORIA SOLTA. MAIS APLICAÇÃO.</p><h2 id="method-title">Aprenda, pratique e leve para <em>o mundo real.</em></h2></div><p>Uma jornada pensada para transformar curiosidade em capacidade de desenhar, testar e melhorar soluções.</p></div><ol class="academy-method__steps"><li><span>01</span><h3>Escolha um objetivo.</h3><p>Comece pelo desafio: uma tarefa, um agente, uma integração ou uma oportunidade de negócio.</p></li><li><span>02</span><h3>Entenda o necessário.</h3><p>Aprenda os conceitos e ferramentas relacionados ao que você quer construir.</p></li><li><span>03</span><h3>Coloque a mão na massa.</h3><p>Transforme conceitos em uma solução que possa ser testada e revisada.</p></li><li><span>04</span><h3>Evolua com confiança.</h3><p>Documente processos, reconheça limites e melhore a solução ao longo do tempo.</p></li></ol><a class="academy-link" href="#formacoes">Escolher minha formação <span aria-hidden="true">↗</span></a></section>

  <section class="academy-section academy-example"><div class="academy-shell academy-example__grid"><div><p class="academy-label">06 / APRENDIZADO QUE GANHA VIDA</p><h2>Imagine uma rotina que antes dependia de <em>várias tarefas manuais.</em></h2><p>Uma empresa precisa reunir dados do ERP, atualizar uma planilha e enviar um resumo ao gestor toda segunda-feira. Em vez de partir direto para uma ferramenta, você aprende a decompor o problema.</p><a class="academy-link academy-link--dark" href="#formacoes">Quero aprender a construir <span aria-hidden="true">↗</span></a></div><div class="academy-example__flow" aria-label="Exemplo ilustrativo das etapas de um projeto de automação"><p>CENÁRIO DEMONSTRATIVO · NÃO É UM CASO DE CLIENTE</p><ol><li><span>01</span>Identificar dados e permissões</li><li><span>02</span>Definir sequência e critérios</li><li><span>03</span>Conectar e validar informações</li><li><span>04</span>Programar execução controlada</li><li><span>05</span>Registrar falhas e revisar resultados</li></ol><strong>O resultado é saber pensar e construir uma solução.</strong></div></div></section>

  <section id="comunidade" class="academy-section academy-community academy-shell" aria-labelledby="community-title"><div class="academy-heading academy-heading--split"><div><p class="academy-label">07 / EM PREPARAÇÃO</p><h2 id="community-title">Conhecimento fica mais útil quando é <em>compartilhado.</em></h2></div><p>A visão da Academy vai além de aulas. Espaços de troca e formatos de orientação poderão ser oferecidos em programas específicos, com regras informadas separadamente.</p></div><div class="academy-community__grid"><article><span>EM PREPARAÇÃO / 01</span><h3>Comunidade de prática</h3><p>Uma proposta de espaço para trocar experiências, dúvidas e projetos com outras pessoas que aplicam IA.</p></article><article><span>EM PREPARAÇÃO / 02</span><h3>Mentoria orientada a desafios</h3><p>Orientação em programas específicos, caso sejam oferecidos. Não está incluída automaticamente em uma formação.</p></article></div></section>

  <section class="academy-section academy-authority"><div class="academy-shell academy-authority__grid"><div><p class="academy-label">08 / APRENDIZADO CONECTADO À PRÁTICA</p><h2>Ensinamos a partir dos desafios que a tecnologia <em>precisa resolver.</em></h2><p>A Tactia atua na construção de software, na execução de processos com IA e na integração de informações para empresas. Essa perspectiva orienta a proposta educacional da Academy.</p></div><div><article><span>01</span><div><h3>Visão de negócio</h3><p>O ponto de partida é o problema, não a ferramenta da moda.</p></div></article><article><span>02</span><div><h3>Visão de engenharia</h3><p>Integrações, segurança, qualidade e operação importam.</p></div></article><article><span>03</span><div><h3>Visão de execução</h3><p>Prototipar é só o começo: é preciso testar e supervisionar.</p></div></article></div></div></section>

  <section id="perguntas" class="academy-section academy-faq academy-shell" aria-labelledby="faq-title"><div class="academy-heading"><p class="academy-label">09 / PERGUNTAS FREQUENTES</p><h2 id="faq-title">Dúvidas antes de começar?<br /><em>Vamos esclarecer.</em></h2></div><div class="academy-faq__list">{questions.map(([question, answer], index) => <details><summary><span>0{index + 1}</span>{question}<b aria-hidden="true">+</b></summary><p>{answer}</p></details>)}</div></section>

  <section id="academy-interest" class="academy-section academy-interest" aria-labelledby="interest-title"><div class="academy-shell academy-interest__grid"><div><p class="academy-label">10 / SEU PRÓXIMO PASSO</p><h2 id="interest-title">O futuro do trabalho não precisa ser algo que você <em>apenas acompanha.</em></h2><p>Estamos preparando a Tactia Academy. Compartilhe seu interesse e entraremos em contato quando houver novidades sobre as primeiras formações.</p><p class="academy-interest__note">Sem matrícula ou cobrança nesta etapa. O envio não garante vaga nem benefício exclusivo. Para registrar a solicitação, pedimos também empresa e WhatsApp.</p><a class="academy-link" href="#formacoes">Rever as formações <span aria-hidden="true">↗</span></a></div><LeadForm id="academy-form" offer="Tactia Academy — aviso de lançamento" heading="Receba novidades da Academy" intro="Deixe seu contato para saber quando as primeiras formações estiverem disponíveis." submitLabel="Quero ser avisado" successHeading="Interesse registrado." successMessage="Recebemos sua solicitação. A equipe da Tactia entrará em contato quando houver novidades sobre a Academy." compact /></div></section>
  <div class="academy-signoff"><div class="academy-shell"><span>TACTIA ACADEMY</span><strong>Aprenda. Aplique. Evolua.</strong></div></div>
</SiteLayout>

<script>
  const emit = (event: string) => window.dispatchEvent(new CustomEvent('tactia:funnel', { detail: { event } }));
  emit('academy_landing_view');

  const header = document.querySelector<HTMLElement>('.workforce-header');
  const updateHeader = () => header?.classList.toggle('academy-header--compact', window.scrollY > 40);
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  document.querySelectorAll<HTMLElement>('[data-academy-event]').forEach((link) => {
    link.addEventListener('click', () => emit(link.dataset.academyEvent || 'academy_course_click'));
  });

  const catalog = document.getElementById('formacoes');
  if (catalog && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        emit('academy_catalog_view');
        observer.disconnect();
      }
    }, { threshold: 0.15 });
    observer.observe(catalog);
  }

  window.addEventListener('tactia:funnel', (event) => {
    if (event instanceof CustomEvent && event.detail?.event === 'lead_submitted' && event.detail?.offer === 'Tactia Academy — aviso de lançamento') {
      emit('academy_waitlist_submit');
    }
  });
</script>
