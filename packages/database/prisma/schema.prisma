  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("metrics")
}

/// Daily materialized metric values (Insights v2 — Etapa 11). Source of truth for
/// trends, baselines and forecasts; recomputed for the last 3 days on every run.
model MetricSnapshot {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  metricKey    String   @map("metric_key")
  /// 'total' | 'product' | 'seller' | 'category' | 'customer'
  dimension    String   @default("total")
  /// Entity id / category name; '' for dimension = 'total'.
  dimensionKey String   @default("") @map("dimension_key")
  bucketDate   DateTime @map("bucket_date") @db.Date
  value        Decimal  @db.Decimal(18, 4)
  computedAt   DateTime @default(now()) @map("computed_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metricKey, dimension, dimensionKey, bucketDate])
  @@index([tenantId, metricKey, dimension, bucketDate])
  @@index([tenantId, bucketDate])
  @@map("metric_snapshots")
}

// ---------------------------------------------------------------------------
// Intelligence — Rules, Insights, Recommendations (Etapa 5)
// ---------------------------------------------------------------------------

model Insight {
  id              String          @id @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  type            InsightType
  severity        InsightSeverity
  status          InsightStatus   @default(open)
  title           String
  description     String
  ruleKey         String          @map("rule_key")
  evidence        Json
  periodFrom      DateTime        @map("period_from")
  periodTo        DateTime        @map("period_to")
  resolvedAt      DateTime?       @map("resolved_at")
  /// Entity the insight is about (product, customer, seller, source...). Null = tenant-wide.
  entityType      String?         @map("entity_type")
  entityId        String?         @map("entity_id") @db.Uuid
  /// Estimated financial impact (tenant currency). Drives ranking.
  impactAmount    Decimal?        @map("impact_amount") @db.Decimal(18, 4)
  /// 0..1 — how much the rule trusts the signal (sample size, baseline quality).
  confidence      Float?
  /// impact × confidence × urgency — used to rank and cap insights per run.
  score           Float           @default(0)
  /// Stable identity of the finding: ruleKey + entity. Dedup and auto-resolve key.
  fingerprint     String
  /// Root-cause decomposition (contributors, price×volume×mix).
  drivers         Json?
  autoResolvedAt  DateTime?       @map("auto_resolved_at")
  dismissReason   String?         @map("dismiss_reason")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]
  feedbacks       InsightFeedback[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, ruleKey, status])
  @@index([tenantId, fingerprint, status])
  @@index([tenantId, status, score])
  @@index([tenantId, entityType, entityId])
  @@map("insights")
}

/// Weekly narrative built from deterministic facts (Etapa 11). Numbers in
/// `content` must appear in `facts` — the generator rejects and retries once.
model Briefing {
