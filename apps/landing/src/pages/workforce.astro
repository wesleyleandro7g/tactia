---
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import SiteLayout from '../components/SiteLayout.astro';
import '../styles/workforce-landing.css';

const pains = [
  ['01', 'Relatórios sempre atrasados', 'Toda semana alguém reúne os mesmos dados em lugares diferentes.'],
  ['02', 'Follow-ups esquecidos', 'O próximo passo depende da memória ou disponibilidade de alguém.'],
  ['03', 'Sistemas que não conversam', 'Informações existem, mas seguem sendo copiadas manualmente.'],
  ['04', 'Gestores presos ao operacional', 'Conferir rotinas toma o espaço de liderar e decidir.'],
];

const roles = [
  { area: 'FINANCEIRO', title: 'Rotinas financeiras com mais clareza.', text: 'Acompanhar pendências, preparar listas para revisão e organizar relatórios com dados autorizados.', deliverable: 'Resumo de pendências e exceções para conferência.', need: 'Fontes de dados, critérios e aprovações.', interest: 'Financeiro' },
  { area: 'COMERCIAL', title: 'Seu funil com próximos passos organizados.', text: 'Classificar oportunidades, preparar acompanhamentos e atualizar registros conforme regras definidas.', deliverable: 'Lista de oportunidades com próximas ações sugeridas.', need: 'CRM, critérios e canais autorizados.', interest: 'Comercial' },
  { area: 'OPERAÇÕES', title: 'Tarefas recorrentes sem perder o fio.', text: 'Consolidar status de pedidos e ordens de serviço, identificar pendências e preparar informes.', deliverable: 'Relatório de status por etapa e responsável.', need: 'Acesso aos sistemas e fluxo de trabalho.', interest: 'Operações' },
  { area: 'GESTÃO', title: 'Informações organizadas antes da reunião.', text: 'Reunir indicadores, pendências e pontos de atenção para apoiar a análise do gestor.', deliverable: 'Briefing com indicadores e questões para decisão.', need: 'Dados confiáveis e critérios de revisão.', interest: 'Gestão' },
];

const demo = [
  ['07:00', 'Início', 'A rotina começa no horário acordado.'],
  ['07:01', 'Consulta', 'Fontes autorizadas fornecem os dados.'],
  ['07:03', 'Conferência', 'Informações são organizadas e divergências sinalizadas.'],
  ['07:05', 'Revisão', 'Uma pessoa verifica exceções e aprova o que exigir decisão.'],
  ['07:10', 'Entrega', 'O relatório é disponibilizado pelo canal combinado.'],
];

const steps = [
  ['01', 'Identificamos uma rotina', 'Você descreve a tarefa, a frequência, os sistemas e a entrega esperada.'],
  ['02', 'Validamos a viabilidade', 'Avaliamos dados, acessos, integrações, volume, riscos e necessidade de revisão humana.'],
  ['03', 'Definimos a contratação', 'Combinamos escopo, preço, implantação, limites e critérios de entrega.'],
  ['04', 'Configuramos e testamos', 'Estruturamos o fluxo e validamos os pontos críticos antes da operação regular.'],
  ['05', 'Acompanhamos a execução', 'As entregas e exceções são acompanhadas conforme as condições contratadas.'],
];

const questions = [
  ['O que é um funcionário digital da Tactia?', 'É uma rotina ou conjunto de atividades executado com agentes de IA, automações e integrações, dentro de um escopo definido. A configuração depende da avaliação de cada empresa.'],
  ['É apenas um chatbot?', 'Não. O foco é executar etapas de trabalho e preparar entregas, com acesso autorizado, regras e pontos de revisão quando necessário.'],
  ['Preciso trocar meu ERP ou CRM?', 'Não necessariamente. Primeiro avaliamos os sistemas existentes, as integrações disponíveis e as permissões de acesso.'],
  ['Posso começar com uma rotina?', 'Sim. Uma atividade recorrente e bem definida costuma ser um ponto de partida para avaliar a viabilidade.'],
  ['Quanto custa e há implantação?', 'Mensalidade, implantação e eventuais custos de ferramentas são definidos em proposta, conforme tarefa, volume, integrações e suporte. Não há preço único para todas as rotinas.'],
  ['Funciona 24 horas por dia?', 'A programação depende do sistema conectado, das janelas de operação e das condições contratadas. Não há promessa de disponibilidade ininterrupta para todas as rotinas.'],
  ['Funcionários digitais podem cometer erros?', 'Sim. IA e automação podem falhar; por isso, o escopo deve prever validações, tratamento de exceções e aprovações para ações sensíveis.'],
  ['Como meus dados são tratados?', 'Acessos, dados e requisitos de privacidade são avaliados de acordo com cada operação e definidos na proposta e no contrato.'],
  ['A Tactia pode enviar mensagens em nosso nome?', 'Isso exige canal apropriado, autorização e observância das políticas aplicáveis. A viabilidade é analisada caso a caso.'],
  ['E se eu precisar de um sistema novo?', 'O desenvolvimento de software ou de integrações complexas pode exigir um projeto separado da Tactia Build.'],
  ['Solicitar avaliação confirma uma contratação?', 'Não. O formulário registra seu interesse para a equipe avaliar a rotina e entrar em contato sobre os próximos passos.'],
];
---

<SiteLayout title="Tactia Workforce | Funcionários Digitais para Empresas" description="Delegue rotinas do financeiro, comercial e operação a funcionários digitais. Conheça a Tactia Workforce e solicite uma avaliação para sua empresa." canonicalPath="/workforce" theme="dark" workforce>
  <section class="wf-hero wf-shell" aria-labelledby="wf-title"><div class="wf-hero__copy"><p class="wf-label"><span aria-hidden="true"><Icon name="sparkle" /></span> TACTIA WORKFORCE · EXECUÇÃO DE ROTINAS</p><h1 id="wf-title">Sua empresa tem trabalho demais. <em>Delegue parte dele para a IA.</em></h1><p class="wf-hero__intro">Funcionários digitais podem executar tarefas definidas no financeiro, comercial e operação — com regras, acompanhamento e aprovações quando necessárias. Você combina a entrega; a Tactia avalia como realizá-la.</p><div class="wf-actions"><a class="wf-button" href="#diagnostico" data-wf-event="workforce_hero_cta_click">Montar minha Workforce <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a><a class="wf-link" href="#funcionarios">Conhecer funcionários digitais <span aria-hidden="true"><Icon name="arrow-down-right" /></span></a></div><p class="wf-hero__note">Conte o que precisa ser feito. Nós avaliamos a rotina e a forma de execução.</p><div class="wf-hero__foot"><span>ENTRADA / UMA TAREFA RECORRENTE</span><i aria-hidden="true"></i><span>SAÍDA / UMA ENTREGA DEFINIDA</span></div></div><div class="wf-console" aria-label="Simulação ilustrativa de um relatório preparado por uma rotina supervisionada"><div class="wf-console__bar"><span>ROTINA / RELATÓRIO SEMANAL</span><span>SIMULAÇÃO 01</span></div><div class="wf-console__body"><p>SEGUNDA-FEIRA · FLUXO EXEMPLIFICATIVO</p><div class="wf-console__event"><span>07:00</span><i></i><div><strong>Rotina iniciada</strong><small>Agendamento definido com a equipe</small></div><b>01</b></div><div class="wf-console__event"><span>07:01</span><i></i><div><strong>Dados consultados</strong><small>ERP e planilha autorizados</small></div><b>02</b></div><div class="wf-console__event"><span>07:03</span><i></i><div><strong>Resumo preparado</strong><small>Dados consolidados · exceção identificada</small></div><b>03</b></div><div class="wf-console__approval"><span>AGUARDANDO REVISÃO</span><strong>1 divergência pede atenção humana.</strong><small>A entrega segue as regras combinadas.</small></div><div class="wf-console__deliverable"><span aria-hidden="true"><Icon name="arrow-up-right" /></span><div><small>ENTREGÁVEL PLANEJADO</small><strong>Relatório para o gestor</strong></div></div></div><p class="wf-console__caption">Exemplo ilustrativo. Não representa operação ou integração já disponível.</p></div></section>

  <div class="wf-strip"><div class="wf-shell"><span>MENOS ROTINAS MANUAIS</span><i aria-hidden="true"><Icon name="sparkle" /></i><span>MAIS ESPAÇO PARA O NEGÓCIO</span><i aria-hidden="true"><Icon name="sparkle" /></i><span>CONTROLE EM CADA ETAPA</span></div></div>

  <section class="wf-section wf-pain" aria-labelledby="wf-pain-title"><div class="wf-shell"><div class="wf-heading"><p class="wf-label">01 / O PESO INVISÍVEL DA OPERAÇÃO</p><h2 id="wf-pain-title">Quanto tempo sua empresa perde fazendo <em>o mesmo trabalho todos os dias?</em></h2><p>Entrar no ERP, exportar uma planilha, procurar dados no CRM, enviar uma mensagem — e repetir tudo amanhã. Cada etapa parece pequena. Somadas, consomem atenção e criam dependências.</p></div><div class="wf-pain__grid">{pains.map(([number, title, text]) => <article><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div><a class="wf-link wf-link--dark" href="#diagnostico">Avaliar uma rotina da minha empresa <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></section>

  <section class="wf-section wf-shift"><div class="wf-shell wf-shift__grid"><div><p class="wf-label">02 / NÃO É MAIS UMA FERRAMENTA PARA APRENDER</p><h2>Não contrate apenas tecnologia. <em>Contrate a execução de um trabalho.</em></h2><p>Ferramentas são úteis, mas não garantem que uma rotina aconteça. A proposta da Workforce é estruturar uma responsabilidade recorrente com entradas, entregas e limites claros.</p></div><div class="wf-shift__sequence"><article><span>01 / VOCÊ DELEGA</span><p>“Prepare o relatório toda segunda-feira.”</p></article><article><span>02 / NÓS ESTRUTURAMOS</span><p>Acessos, regras, calendário e responsáveis.</p></article><article><span>03 / A ROTINA EXECUTA</span><p>Consulta, organiza e sinaliza exceções.</p></article><article><span>04 / VOCÊ ACOMPANHA</span><p>Recebe a entrega e aprova decisões sensíveis.</p></article></div></div></section>

  <section id="funcionarios" class="wf-section wf-roles" aria-labelledby="wf-roles-title"><div class="wf-shell"><div class="wf-heading wf-heading--split"><div><p class="wf-label">03 / MONTE SUA FORÇA DE TRABALHO DIGITAL</p><h2 id="wf-roles-title">Comece por uma função. <em>Defina uma entrega.</em></h2></div><p>Os exemplos abaixo são possibilidades sob avaliação, não um catálogo de serviços prontos. Configuração, frequência e integrações dependem do diagnóstico.</p></div><div class="wf-roles__grid">{roles.map((role, index) => <article><div class="wf-roles__top"><span>{String(index + 1).padStart(2, '0')} / {role.area}</span><span>EXEMPLO DE FUNÇÃO</span></div><h3>{role.title}</h3><p>{role.text}</p><div class="wf-roles__detail"><small>ENTREGA POSSÍVEL</small><strong>{role.deliverable}</strong></div><p class="wf-roles__need">Para operar: {role.need}</p><a href="#diagnostico" data-wf-role={role.interest}>Avaliar esta rotina <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></article>)}<article class="wf-roles__custom"><span>SUA EMPRESA / SUA ROTINA</span><h3>Não encontrou a tarefa que quer delegar?</h3><p>Descreva o processo. Vamos avaliar a viabilidade, os acessos necessários e se há alguma implementação adicional.</p><a href="#diagnostico" data-wf-role="Outra rotina">Descrever minha rotina <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></article></div></div></section>

  <section class="wf-section wf-demo" aria-labelledby="wf-demo-title"><div class="wf-shell"><div class="wf-heading wf-heading--split"><div><p class="wf-label">04 / UMA ROTINA SAINDO DO PAPEL</p><h2 id="wf-demo-title">Você pede um relatório. <em>A execução vira um fluxo.</em></h2></div><p>Simulação de um relatório semanal de vendas. O processo só pode ser estruturado após avaliar sistemas, acessos, qualidade dos dados e pontos de aprovação.</p></div><div class="wf-demo__table"><div class="wf-demo__header"><span>HORÁRIO ILUSTRATIVO</span><span>ETAPA</span><span>RESULTADO ESPERADO</span></div>{demo.map(([time, title, result]) => <div class="wf-demo__row"><span>{time}</span><strong>{title}</strong><p>{result}</p></div>)}</div><p class="wf-demo__disclaimer">Fluxo demonstrativo, não um caso de cliente nem promessa de duração. A entrega e os horários dependem do escopo.</p><a class="wf-link wf-link--dark" href="#diagnostico">Avaliar uma rotina parecida <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></section>

  <section class="wf-section wf-value"><div class="wf-shell"><div class="wf-heading"><p class="wf-label">05 / VALOR QUE PODE SER ACOMPANHADO</p><h2>Delegar não é perder o controle. É saber <em>o que foi feito.</em></h2></div><div class="wf-value__grid"><article><span>01</span><h3>Tempo dedicado à rotina</h3><p>Compare a dedicação antes e depois, quando houver dados confiáveis.</p></article><article><span>02</span><h3>Frequência de entrega</h3><p>Acompanhe se a rotina acontece conforme o calendário acordado.</p></article><article><span>03</span><h3>Exceções e revisões</h3><p>Registre divergências e intervenções necessárias.</p></article><article><span>04</span><h3>Previsibilidade</h3><p>Defina responsáveis por cada decisão e ponto de aprovação.</p></article></div><p class="wf-value__note">Sem porcentagens de economia ou resultados garantidos: o que vale medir depende da rotina real.</p></div></section>

  <section id="como-funciona" class="wf-section wf-method" aria-labelledby="wf-method-title"><div class="wf-shell"><div class="wf-heading wf-heading--split"><div><p class="wf-label">06 / DA TAREFA À ENTREGA</p><h2 id="wf-method-title">Você explica o trabalho. Nós avaliamos <em>como executá-lo.</em></h2></div><p>Nem toda tarefa é adequada à automação. Começamos pela viabilidade e definimos limites antes de operar.</p></div><ol class="wf-method__steps">{steps.map(([number, title, text]) => <li><span>{number}</span><div><h3>{title}</h3><p>{text}</p></div><b aria-hidden="true"><Icon name="arrow-up-right" /></b></li>)}</ol><a class="wf-link wf-link--dark" href="#diagnostico">Montar minha Workforce <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></section>

  <section class="wf-section wf-control"><div class="wf-shell"><div class="wf-heading wf-heading--split"><div><p class="wf-label">07 / AUTOMAÇÃO COM RESPONSABILIDADE</p><h2>Sua empresa delega o trabalho. <em>Não abre mão do controle.</em></h2></div><p>Acessos, autonomia, revisão humana e tratamento de dados dependem da tarefa, dos sistemas e das condições técnicas e contratuais.</p></div><div class="wf-control__grid"><article><span>01 / ACESSOS</span><h3>Permissões proporcionais</h3><p>Definimos quais dados e sistemas são necessários para a tarefa, conforme o ambiente disponível.</p></article><article><span>02 / DECISÕES</span><h3>Aprovação para ações sensíveis</h3><p>Pagamentos, exclusões ou comunicações delicadas podem exigir validação humana.</p></article><article><span>03 / ACOMPANHAMENTO</span><h3>Exceções visíveis</h3><p>Registros e verificações são planejados de acordo com a arquitetura e o contrato.</p></article><article><span>04 / DADOS</span><h3>Privacidade no escopo</h3><p>Tratamento e retenção dos dados devem ser definidos para a operação específica.</p></article></div></div></section>

  <section id="planos" class="wf-section wf-pricing" aria-labelledby="wf-pricing-title"><div class="wf-shell"><div class="wf-heading wf-heading--split"><div><p class="wf-label">08 / COMECE PELO QUE PRECISA</p><h2 id="wf-pricing-title">Uma rotina de cada vez. <em>Um escopo claro para cada proposta.</em></h2></div><p>Não há mensalidade única publicada. Frequência, volume, integrações, ferramentas, suporte e possível implantação são avaliados antes da contratação.</p></div><div class="wf-pricing__grid"><article><span>01 / UMA ROTINA</span><h3>Começar com foco.</h3><p>Delegue uma tarefa recorrente com entradas, saídas e limites definidos.</p></article><article><span>02 / UMA ÁREA</span><h3>Conectar atividades.</h3><p>Combine tarefas relacionadas de uma área, se houver viabilidade operacional.</p></article><article><span>03 / UMA WORKFORCE</span><h3>Ampliar com critério.</h3><p>Avalie a coordenação de rotinas diferentes após validar as primeiras entregas.</p></article></div><div class="wf-pricing__note"><p><strong>Como é definido o investimento?</strong> A proposta informa mensalidade, limites, responsabilidades e eventuais custos de implantação ou integrações. Desenvolvimento complexo pode exigir projeto separado da Build.</p><a class="wf-button" href="#diagnostico">Solicitar avaliação <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></div></section>

  <section class="wf-section wf-ecosystem"><div class="wf-shell wf-ecosystem__grid"><div><p class="wf-label">09 / QUATRO CAMINHOS, PAPÉIS DIFERENTES</p><h2>Execução é uma parte de uma empresa <em>mais inteligente.</em></h2><p>Workforce delega rotinas. Build desenvolve a estrutura quando necessária. Academy prepara as pessoas. Intelligence tem foco em dados e decisão. São ofertas distintas.</p></div><div class="wf-ecosystem__list"><p><span>APRENDA</span> Academy <small>Educação aplicada.</small></p><p><span>CONSTRUA</span> Build <small>Software sob medida.</small></p><p><span>DELEGUE</span> Workforce <small>Execução recorrente.</small></p><p><span>DECIDA</span> Intelligence <small>Informação para o negócio.</small></p></div></div></section>

  <section id="duvidas" class="wf-section wf-faq" aria-labelledby="wf-faq-title"><div class="wf-shell wf-faq__grid"><div><p class="wf-label">10 / PERGUNTAS FREQUENTES</p><h2 id="wf-faq-title">Dúvidas antes de delegar sua <em>primeira rotina?</em></h2></div><div class="wf-faq__list">{questions.map(([question, answer], index) => <details><summary><span>{String(index + 1).padStart(2, '0')}</span>{question}<b aria-hidden="true">+</b></summary><p>{answer}</p></details>)}</div></div></section>

  <section id="diagnostico" class="wf-section wf-contact" aria-labelledby="wf-contact-title"><div class="wf-shell wf-contact__grid"><div><p class="wf-label">11 / COMECE POR UMA TAREFA</p><h2 id="wf-contact-title">Qual trabalho você gostaria de tirar da agenda <em>da sua equipe?</em></h2><p>Conte como funciona uma rotina da empresa. Vamos avaliar o que pode ser delegado, quais sistemas estão envolvidos e se existe um caminho viável.</p><p class="wf-contact__note">O envio solicita uma avaliação inicial; não confirma contratação nem reunião. O formulário atual pede empresa, e-mail e WhatsApp para que possamos responder.</p></div><LeadForm id="workforce-form" offer="Tactia Workforce — avaliação de rotina" heading="Conte qual rotina quer delegar" intro="Descreva a tarefa e retornaremos pelos contatos informados para discutir os próximos passos." submitLabel="Solicitar avaliação" contextLabel="Qual rotina você gostaria de delegar?" contextPlaceholder="Ex.: toda segunda-feira reunimos dados de vendas e preparamos um relatório para o gestor." requireContext successHeading="Recebemos sua solicitação." successMessage="Nossa equipe analisará as informações para orientar o próximo passo. Se necessário, entraremos em contato para entender melhor o processo." /></div></section>
  <div class="wf-signoff"><div class="wf-shell"><span>TACTIA / WORKFORCE</span><strong>Delegue o trabalho. Mantenha o controle.</strong></div></div>
</SiteLayout>

<script>
  const emit = (event: string, detail: Record<string, string> = {}) => window.dispatchEvent(new CustomEvent('tactia:funnel', { detail: { event, ...detail } }));
  emit('workforce_page_view');
  const header = document.querySelector<HTMLElement>('.workforce-header');
  const updateHeader = () => header?.classList.toggle('wf-header--compact', window.scrollY > 40);
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  document.querySelector('[data-wf-event]')?.addEventListener('click', () => emit('workforce_hero_cta_click', { placement: 'hero' }));
  const catalog = document.getElementById('funcionarios');
  if (catalog && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) { emit('workforce_catalog_view', { section_id: 'funcionarios' }); observer.disconnect(); }
    }, { threshold: 0.15 });
    observer.observe(catalog);
  }
  document.querySelectorAll<HTMLAnchorElement>('[data-wf-role]').forEach((link) => link.addEventListener('click', () => {
    const interest = link.dataset.wfRole || 'Outra rotina';
    const field = document.querySelector<HTMLInputElement>('#workforce-form [name="diagnosis"]');
    if (field) field.value = `Área de interesse: ${interest}`;
    emit('workforce_worker_select', { worker_type: interest });
  }));
  window.addEventListener('tactia:funnel', (event) => {
    if (!(event instanceof CustomEvent) || event.detail?.offer !== 'Tactia Workforce — avaliação de rotina') return;
    if (event.detail.event === 'form_started') emit('workforce_form_start', { form_id: 'workforce-form' });
    if (event.detail.event === 'lead_submitted') emit('workforce_form_submit');
  });
</script>
