// ---------------------------------------------------------------------------
// Scheduling — agendamento de ações por empresa
// ---------------------------------------------------------------------------

/// A recurring (or manual) schedule that triggers the AI agent or a catalog
/// action for a tenant. Recurrence is hybrid: a structured `frequency` +
/// `recurrenceConfig` covers the common cases and an optional `cronExpression`
/// covers the custom trigger. `manual` never fires automatically.
model Schedule {
  id               String             @id @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  name             String
  description      String?
  enabled          Boolean            @default(true)
  target           ScheduleTarget
  effectMode       ScheduleEffectMode @default(propose) @map("effect_mode")
  frequency        ScheduleFrequency
  /// Structured recurrence: { weekdays?: number[], dayOfMonth?: number,
  /// nthBusinessDay?: number, localTime?: "HH:mm" }.
  recurrenceConfig Json               @default("{}") @map("recurrence_config")
  /// Optional cron string used when frequency = custom.
  cronExpression   String?            @map("cron_expression")
  /// Overrides tenant timezone when set.
  timezone         String?
  repeatMode       ScheduleRepeatMode @default(infinite) @map("repeat_mode")
  /// Total successful occurrences allowed when repeatMode = count.
  maxOccurrences   Int?               @map("max_occurrences")
  /// Successful occurrences so far (failures do not count — spec resiliência).
  successCount     Int                @default(0) @map("success_count")
  /// Payload for target = ai_agent: { systemPrompt?, instruction, tools?: string[], skillIds?: string[] }.
  aiConfig         Json?              @map("ai_config")
  /// Payload for target = action.
  actionType       ActionType?        @map("action_type")
  actionInput      Json?              @map("action_input")
  lastRunAt        DateTime?          @map("last_run_at")
  createdBy        String?            @map("created_by") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occurrences      ScheduleOccurrence[]

  @@index([tenantId, enabled])
  @@index([tenantId, createdAt])
  @@map("schedules")
}

/// One firing of a schedule for a given period. `periodKey` makes each period
/// idempotent: the tick may retry, but only one occurrence exists per period,
/// so work already done is never repeated (spec resiliência §5.1). A reset
/// (§5.2) is the only way to re-run a completed period.
model ScheduleOccurrence {
  id                String                   @id @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  scheduleId        String                   @map("schedule_id") @db.Uuid
  /// Stable key per period: e.g. "2026-01-15", "2026-W03", "manual:<ts>".
  periodKey         String                   @map("period_key")
  status            ScheduleOccurrenceStatus @default(pending)
  /// user | ai | system — who originated the occurrence.
  origin            String                   @default("system")
  actionExecutionId String?                  @map("action_execution_id") @db.Uuid
  output            Json?
  error             String?
  startedAt         DateTime?                @map("started_at")
  finishedAt        DateTime?                @map("finished_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedule          Schedule                 @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scheduleId, periodKey])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([scheduleId])
  @@map("schedule_occurrences")
}

// ---------------------------------------------------------------------------
// Memory — Episodes e Playbooks (Etapa 15 / Onda 2)
// ---------------------------------------------------------------------------

model Episode {
  id                String         @id @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  kind              EpisodeKind
  outcome           EpisodeOutcome
  text              String
  actionExecutionId String?        @map("action_execution_id") @db.Uuid
  approvalId        String?        @map("approval_id") @db.Uuid
  entityType        String?        @map("entity_type")
  entityId          String?        @map("entity_id") @db.Uuid
  /// Written via raw SQL (pgvector). Never selected through Prisma.
  embedding         Unsupported("vector")?
  embeddedAt        DateTime?      @map("embedded_at")
  occurredAt        DateTime       @map("occurred_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionExecution   ActionExecution? @relation(fields: [actionExecutionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, actionExecutionId, outcome])
  @@index([tenantId, occurredAt])
  @@index([tenantId, kind])
  @@index([tenantId, actionExecutionId])
  @@map("episodes")
}

model Playbook {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  slug       String
  title      String
  trigger    String
  steps      Json
  enabled    Boolean   @default(true)
  /// Written via raw SQL (pgvector). Never selected through Prisma.
  embedding  Unsupported("vector")?
  embeddedAt DateTime? @map("embedded_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, enabled])
  @@map("playbooks")
}

// ---------------------------------------------------------------------------
// Knowledge documents + multimodal ingest (Etapa 16 / Onda 3)
// ---------------------------------------------------------------------------

model KnowledgeDocument {
  id         String                  @id @db.Uuid
  tenantId   String                  @map("tenant_id") @db.Uuid
  title      String
  kind       KnowledgeDocumentKind   @default(other)
  mime       String
  storageKey String                  @map("storage_key")
  checksum   String
  byteSize   Int                     @map("byte_size")
  status     KnowledgeDocumentStatus @default(pending)
  error      String?
  uploadedBy String?                 @map("uploaded_by") @db.Uuid
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")
  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks     DocumentChunk[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@unique([tenantId, checksum])
  @@map("knowledge_documents")
}

model DocumentChunk {
  id         String            @id @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  documentId String            @map("document_id") @db.Uuid
  ordinal    Int
  heading    String?
  page       Int?
  text       String
  tokenCount Int               @map("token_count")
  /// Written via raw SQL (pgvector). Never selected through Prisma.
  embedding  Unsupported("vector")?
  embeddedAt DateTime?         @map("embedded_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([tenantId, documentId])
  @@map("document_chunks")
}

model MediaAsset {
  id             String            @id @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  purpose        MediaAssetPurpose @default(auto)
  mime           String
  storageKey     String            @map("storage_key")
  checksum       String
  byteSize       Int               @map("byte_size")
  status         MediaAssetStatus  @default(pending)
  error          String?
  classification String?
  resultKind     String?           @map("result_kind")
  resultId       String?           @map("result_id") @db.Uuid
  uploadedBy     String?           @map("uploaded_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("media_assets")
}

model InfographicAsset {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  title      String
  template   String
  mime       String
  storageKey String   @map("storage_key")
  byteSize   Int      @map("byte_size")
  width      Int
  height     Int
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("infographic_assets")
}
