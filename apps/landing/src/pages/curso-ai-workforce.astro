---
import LeadForm from '../components/LeadForm.astro';
import SiteLayout from '../components/SiteLayout.astro';

const checkoutUrl = import.meta.env.PUBLIC_COURSE_CHECKOUT_URL;
const primaryHref = checkoutUrl || '#curso-interesse';
const primaryLabel = checkoutUrl ? 'Quero criar meus agentes' : 'Quero receber o link de compra';
---

<SiteLayout title="Curso AI Workforce — Crie seus agentes de IA | Tactia" description="Aprenda a transformar tarefas e processos em agentes de IA úteis para seu trabalho ou negócio. Curso AI Workforce por R$ 497." canonicalPath="/curso-ai-workforce">
  <section class="product-hero product-hero--course workforce-shell">
    <div><p class="eyebrow"><span class="dot"></span> CURSO AI WORKFORCE</p><p class="product-hero__kicker">APRENDA A CRIAR</p><h1>Construa a força de trabalho de IA que o seu trabalho precisa.</h1><p class="product-hero__description">Um curso para transformar tarefas e processos em agentes de IA úteis — com pensamento prático antes de ferramenta.</p><div class="product-hero__price"><strong>R$ 497</strong><span>pagamento único</span></div><div class="workforce-actions"><a class="button workforce-button" href={primaryHref}><span>{primaryLabel}</span><span aria-hidden="true">↗</span></a><a class="workforce-text-action" href="#para-quem">Ver se é para mim <span aria-hidden="true">↓</span></a></div>{!checkoutUrl && <p class="product-hero__note">As vagas serão comunicadas pelo contato informado. Não há cobrança nesta etapa.</p>}</div>
    <div class="course-composition" aria-label="Ilustração de etapas para criação de um agente de IA"><div class="course-composition__label">DO PROCESSO AO AGENTE</div><div class="course-card course-card--one"><span>01</span><strong>Mapear</strong><p>o trabalho que se repete</p></div><div class="course-card course-card--two"><span>02</span><strong>Desenhar</strong><p>instruções e contexto</p></div><div class="course-card course-card--three"><span>03</span><strong>Testar</strong><p>o que realmente ajuda</p></div><div class="course-composition__line" aria-hidden="true"></div><div class="course-composition__core"><img src="/tactia-symbol.svg" width="56" height="56" alt="" /></div></div>
  </section>
  <section id="para-quem" class="course-fit workforce-shell"><div class="section-lead"><div><p class="eyebrow"><span class="dot"></span> PARA QUEM É</p><h2>Antes de criar, é preciso <em>enxergar o trabalho.</em></h2></div><p>O curso foi pensado para quem quer sair da curiosidade sobre IA e começar a desenhar soluções úteis para tarefas reais.</p></div><div class="fit-grid"><article><span>↗</span><h3>Profissionais</h3><p>Que querem aplicar IA ao próprio trabalho com mais autonomia e critério.</p></article><article><span>↗</span><h3>Empreendedores</h3><p>Que desejam transformar processos repetitivos em sistemas de apoio.</p></article><article><span>↗</span><h3>Equipes e consultores</h3><p>Que precisam aprender uma forma mais estruturada de desenhar agentes.</p></article></div></section>
  <section class="course-method workforce-section workforce-section--cream"><div class="workforce-shell"><div class="section-lead"><div><p class="eyebrow"><span class="dot"></span> A ABORDAGEM</p><h2>Não comece pela ferramenta. <em>Comece pelo problema.</em></h2></div><p>O foco é aprender a transformar contexto, regras e tarefas em uma base clara para criar e testar agentes.</p></div><ol class="course-method__steps"><li><span>01</span><h3>Encontrar a tarefa certa</h3><p>Identificar uma rotina que vale compreender antes de tentar automatizar.</p></li><li><span>02</span><h3>Dar contexto ao agente</h3><p>Estruturar objetivo, instruções, limites e referências de forma compreensível.</p></li><li><span>03</span><h3>Testar com responsabilidade</h3><p>Avaliar utilidade, ajustar o processo e preservar a supervisão humana necessária.</p></li></ol></div></section>
  <section class="course-boundary workforce-shell"><div><p class="eyebrow"><span class="dot"></span> EXPECTATIVA CORRETA</p><h2>Um curso para construir repertório e prática — não promessas mágicas.</h2></div><p>O resultado de cada agente depende do processo, das informações disponíveis, das ferramentas utilizadas e dos critérios de revisão de quem o coloca em uso.</p></section>
  <section id="curso-interesse" class="form-section form-section--course"><div class="workforce-shell form-section__grid"><div><p class="eyebrow"><span class="dot"></span> CURSO AI WORKFORCE</p><h2>Pronto para colocar essa ideia em prática?</h2><p>Deixe seu contato para receber o link de compra e as informações de abertura da turma.</p><p class="form-section__small">Preço de referência: R$ 497, pagamento único.</p></div><LeadForm id="curso-form" offer="Curso AI Workforce — interesse de compra" heading="Receba o próximo passo" intro="Conte para a Tactia que você quer saber sobre o curso." submitLabel="Quero receber o link de compra" compact /></div></section>
</SiteLayout>
