model BrowserWorkflowBinding {
  id                 String   @id @db.Uuid
  tenantId           String?  @map("tenant_id") @db.Uuid
  provider           String
  engine             String
  workflowKey        String   @map("workflow_key")
  workflowVersion    String   @map("workflow_version")
  environment        String
  instanceKey        String   @map("instance_key")
  externalTaskId     String   @map("external_task_id")
  definitionChecksum String?  @map("definition_checksum")
  reconciliationMarker String? @map("reconciliation_marker")
  browserExecutorInstanceId String? @map("browser_executor_instance_id") @db.Uuid
  workflowRevisionId String?  @map("workflow_revision_id") @db.Uuid
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  tenant             Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance           BrowserExecutorInstance? @relation(fields: [browserExecutorInstanceId], references: [id], onDelete: SetNull)
  workflowRevision   BrowserWorkflowRevision? @relation(fields: [workflowRevisionId], references: [id], onDelete: SetNull)

  @@unique([provider, engine, workflowKey, workflowVersion, environment, instanceKey])
  @@index([provider, environment, active])
  @@index([tenantId])
  @@index([browserExecutorInstanceId])
  @@index([workflowRevisionId])
  @@map("browser_workflow_bindings")
}

// A backend-resolved, tenant-scoped browser executor instance. Replaces the
// FIGRANIUM_INSTANCES_JSON env document (which remains a read-only fallback).
// The API key lives in a Credential; only its reference is stored here.
model BrowserExecutorInstance {
  id                   String   @id @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  provider             String
  engine               String
  instanceKey          String   @map("instance_key")
  baseUrl              String   @map("base_url")
  dedicatedConnectionId String? @unique @map("dedicated_connection_id") @db.Uuid
  apiKeyCredentialId   String   @map("api_key_credential_id") @db.Uuid
  environment          String
  allowInsecureHttp    Boolean  @default(false) @map("allow_insecure_http")
  active               Boolean  @default(true)
  lastHealthAt         DateTime? @map("last_health_at")
  lastHealthStatus     String?   @map("last_health_status")
  lastHealthMessage    String?   @map("last_health_message")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeyCredential     Credential @relation(fields: [apiKeyCredentialId], references: [id], onDelete: Restrict)
  dedicatedConnection  DataSource? @relation("DedicatedBrowserConnection", fields: [dedicatedConnectionId], references: [id], onDelete: SetNull)
  bindings             BrowserWorkflowBinding[]

  @@unique([tenantId, provider, engine, instanceKey, environment])
  @@index([tenantId, provider, environment, active])
  @@map("browser_executor_instances")
}

// Logical workflow (stable identity per tenant/provider/environment). The task
// definition itself lives in immutable revisions; the workflow points at the
// currently active revision.
model BrowserWorkflow {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  provider         String
  engine           String
  workflowKey      String   @map("workflow_key")
  environment      String
  activeRevisionId String?  @unique @map("active_revision_id") @db.Uuid
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activeRevision   BrowserWorkflowRevision? @relation("BrowserWorkflowActiveRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull)
  revisions        BrowserWorkflowRevision[] @relation("BrowserWorkflowRevisions")

  @@unique([tenantId, provider, engine, workflowKey, environment])
  @@index([tenantId, provider, environment, active])
  @@map("browser_workflows")
}

// Immutable internal revision of a workflow definition. Rows are append-only:
// importing JSON substitutes the active revision by creating a new one, never
// mutating an existing definition.
model BrowserWorkflowRevision {
  id                 String   @id @db.Uuid
  workflowId         String   @map("workflow_id") @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  revision           Int
  workflowVersion    String   @map("workflow_version")
  definition         Json
  definitionChecksum String   @map("definition_checksum")
  publishable        Boolean  @default(false)
  createdBy          String?  @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  workflow           BrowserWorkflow @relation("BrowserWorkflowRevisions", fields: [workflowId], references: [id], onDelete: Cascade)
  activeFor          BrowserWorkflow? @relation("BrowserWorkflowActiveRevision")
  bindings           BrowserWorkflowBinding[]

  @@unique([workflowId, revision])
  @@index([workflowId])
  @@index([tenantId])
  @@map("browser_workflow_revisions")
}

model AgentSkill {
  id          String         @id @db.Uuid
